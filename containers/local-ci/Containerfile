# Dedicated Linux arm64 CI dependencies; no candidate source or tests in preparation.
FROM ghcr.io/astral-sh/uv@sha256:40edad71a1710a9d5d988c6a034304e9c414d7f794dab44a0781d619bba41d33 AS uv
FROM python@sha256:80c55071c580609f3f1e787825e001ea571cee4dfce4f375c537bc790d76258f
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_CACHE_DIR=/opt/uv-cache
WORKDIR /opt/dependency-input
# The launcher stages ONLY these declared files, never a repository/home context.
COPY pyproject.toml uv.lock .python-version ./
COPY build-requirements.txt image-lock.json prepare_dependencies.py /opt/local-ci/
RUN python /opt/local-ci/prepare_dependencies.py
RUN uv sync --all-groups --frozen --no-install-project --no-editable
RUN uv pip install --target /opt/build-backends --require-hashes -r /opt/local-ci/build-requirements.txt
RUN python --version && uv --version && /opt/quarto/bin/quarto --version
COPY run_gates.py offline_guard.py sitecustomize.py /opt/local-ci/
ENV PATH=/opt/quarto/bin:/usr/local/bin:/usr/bin:/bin
ENV UV_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python", "/opt/local-ci/run_gates.py"]
