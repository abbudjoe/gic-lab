{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/lambda-v3-global-firewall-ruleset-response.schema.json",
  "title": "Lambda Cloud global firewall-ruleset response used by T07 Gate L1 V3",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["id", "name", "rules"],
      "properties": {
        "id": {"const": "global"},
        "name": {"type": "string", "minLength": 1},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["protocol", "source_network", "description"],
      "properties": {
        "protocol": {"enum": ["tcp", "udp", "icmp", "all"]},
        "port_range": {
          "type": ["array", "null"],
          "prefixItems": [
            {"type": "integer", "minimum": 1, "maximum": 65535},
            {"type": "integer", "minimum": 1, "maximum": 65535}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source_network": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
