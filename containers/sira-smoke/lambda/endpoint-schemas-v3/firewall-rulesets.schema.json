{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/lambda-v3-firewall-rulesets-response.schema.json",
  "title": "Lambda Cloud regional firewall-rulesets response used by T07 Gate L1 V3",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "region", "rules", "created", "instance_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "region": {"$ref": "#/$defs/region"},
          "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
          "created": {"type": "string", "minLength": 1},
          "instance_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "region": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "rule": {
      "type": "object",
      "required": ["protocol", "source_network", "description"],
      "properties": {
        "protocol": {"enum": ["tcp", "udp", "icmp", "all"]},
        "port_range": {
          "type": ["array", "null"],
          "prefixItems": [
            {"type": "integer", "minimum": 1, "maximum": 65535},
            {"type": "integer", "minimum": 1, "maximum": 65535}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source_network": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
