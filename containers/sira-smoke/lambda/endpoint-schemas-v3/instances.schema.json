{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/lambda-v3-instances-response.schema.json",
  "title": "Lambda Cloud instances response used by T07 Gate L1 V3",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "ssh_key_names",
          "file_system_names",
          "region",
          "instance_type",
          "actions"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["booting", "active", "unhealthy", "terminated", "terminating", "preempted"]
          },
          "ssh_key_names": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "file_system_names": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "region": {"$ref": "#/$defs/region"},
          "instance_type": {"$ref": "#/$defs/instance_type"},
          "actions": {
            "type": "object",
            "required": ["migrate", "rebuild", "restart", "cold_reboot", "terminate"],
            "properties": {
              "migrate": {"$ref": "#/$defs/action_availability"},
              "rebuild": {"$ref": "#/$defs/action_availability"},
              "restart": {"$ref": "#/$defs/action_availability"},
              "cold_reboot": {"$ref": "#/$defs/action_availability"},
              "terminate": {"$ref": "#/$defs/action_availability"}
            },
            "additionalProperties": true
          },
          "name": {"type": "string", "maxLength": 64},
          "ip": {"type": "string", "minLength": 1},
          "private_ip": {"type": "string", "minLength": 1},
          "file_system_mounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["mount_point", "file_system_id"],
              "properties": {
                "mount_point": {"type": "string", "minLength": 1},
                "file_system_id": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "hostname": {"type": "string", "minLength": 1},
          "jupyter_token": {"type": "string", "minLength": 1},
          "jupyter_url": {"type": "string", "minLength": 1},
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "value": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "firewall_rulesets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {"id": {"type": "string", "minLength": 1}},
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "action_availability": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": {"type": "boolean"},
        "reason_code": {"type": "string"},
        "reason_description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "region": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "instance_type": {
      "type": "object",
      "required": [
        "name",
        "description",
        "gpu_description",
        "price_cents_per_hour",
        "specs",
        "architecture"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "gpu_description": {"type": "string"},
        "price_cents_per_hour": {"type": "integer", "minimum": 0},
        "specs": {
          "type": "object",
          "required": ["vcpus", "memory_gib", "storage_gib", "gpus"],
          "properties": {
            "vcpus": {"type": "integer", "minimum": 1},
            "memory_gib": {"type": "integer", "minimum": 1},
            "storage_gib": {"type": "integer", "minimum": 1},
            "gpus": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        "architecture": {"enum": ["x86_64", "arm64"]}
      },
      "additionalProperties": true
    }
  }
}
