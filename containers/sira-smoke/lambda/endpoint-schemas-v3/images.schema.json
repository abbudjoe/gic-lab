{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/lambda-v3-images-response.schema.json",
  "title": "Lambda Cloud images response used by T07 Gate L1 V3",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "created_time",
          "updated_time",
          "name",
          "description",
          "family",
          "version",
          "architecture",
          "region"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "created_time": {"type": "string", "minLength": 1},
          "updated_time": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "family": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "architecture": {"enum": ["x86_64", "arm64"]},
          "region": {"$ref": "#/$defs/region"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "region": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
