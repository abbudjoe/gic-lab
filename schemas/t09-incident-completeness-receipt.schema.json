{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t09-incident-completeness-receipt.schema.json",
  "title": "T09 incident completeness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_commit",
    "repository_tree",
    "incident_count",
    "incidents",
    "complete",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repository_commit": {"$ref": "#/$defs/git"},
    "repository_tree": {"$ref": "#/$defs/git"},
    "incident_count": {"type": "integer", "minimum": 1},
    "incidents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_id",
          "path",
          "status",
          "regression_nodes",
          "regressions_passed",
          "regression_output",
          "errors",
          "complete"
        ],
        "properties": {
          "incident_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^control/incidents/.+\\.json$"},
          "status": {"type": "string", "minLength": 1},
          "regression_nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^tests/.+::.+$"}
          },
          "regressions_passed": {"type": ["boolean", "null"]},
          "regression_output": {"type": "string"},
          "errors": {"type": "array", "items": {"type": "string"}},
          "complete": {"type": "boolean"}
        }
      }
    },
    "complete": {"type": "boolean"},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "git": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
