{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t09-agent-check-receipt.schema.json",
  "title": "T09 aggregate agent check receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_commit",
    "repository_tree",
    "selected_runtime_target",
    "selected_composition_semantic_sha256",
    "checks",
    "complete",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": {"enum": ["2.0.0", "3.0.0", "4.0.0"]},
    "repository_commit": {"$ref": "#/$defs/git"},
    "repository_tree": {"$ref": "#/$defs/git"},
    "selected_runtime_target": {"$ref": "#/$defs/target"},
    "selected_composition_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_version_lint",
        "registry_completeness",
        "incident_completeness",
        "offline_composition",
        "category3_shadow",
        "state_capsule",
        "source_binding"
      ],
      "properties": {
        "active_version_lint": {"$ref": "#/$defs/check"},
        "registry_completeness": {"$ref": "#/$defs/check"},
        "incident_completeness": {"$ref": "#/$defs/check"},
        "offline_composition": {"type": "object"},
        "category3_shadow": {"type": "object"},
        "state_capsule": {"$ref": "#/$defs/check"},
        "source_binding": {"$ref": "#/$defs/check"},
        "anti_shadow_lint": {"$ref": "#/$defs/check"},
        "live_effect_conformance": {"$ref": "#/$defs/check"},
        "live_method_viability": {"$ref": "#/$defs/check"},
        "remote_execution_bridge_conformance": {"$ref": "#/$defs/check"}
      }
    },
    "complete": {"type": "boolean"},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "3.0.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "checks": {
            "required": [
              "active_version_lint",
              "registry_completeness",
              "incident_completeness",
              "offline_composition",
              "category3_shadow",
              "state_capsule",
              "source_binding",
              "anti_shadow_lint",
              "live_effect_conformance"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "4.0.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "checks": {
            "required": [
              "active_version_lint",
              "registry_completeness",
              "incident_completeness",
              "offline_composition",
              "category3_shadow",
              "state_capsule",
              "source_binding",
              "anti_shadow_lint",
              "live_effect_conformance",
              "live_method_viability",
              "remote_execution_bridge_conformance"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "git": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^V[1-9][0-9]*$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "goal_record_path",
        "goal_record_sha256",
        "historical_contract_version",
        "successor_contract_version",
        "successor_status",
        "selected_provider_contract_version",
        "selected_plan_id",
        "selected_command_package_sha256",
        "selected_package_status",
        "authority",
        "semantic_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source": {"enum": ["goal-record", "explicit-provider-contract"]},
        "goal_record_path": {"const": "control/goals/EXP-0001.yaml"},
        "goal_record_sha256": {"$ref": "#/$defs/sha256"},
        "historical_contract_version": {"$ref": "#/$defs/version"},
        "successor_contract_version": {"$ref": "#/$defs/version"},
        "successor_status": {"enum": ["not-created", "package-bound-not-authorized"]},
        "selected_provider_contract_version": {"$ref": "#/$defs/version"},
        "selected_plan_id": {"type": "string", "pattern": "^PLAN-EXP0001-PILOT-V[1-9][0-9]*$"},
        "selected_command_package_sha256": {"$ref": "#/$defs/sha256"},
        "selected_package_status": {"type": "string", "minLength": 1},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live_authorization", "scientific_interpretation_allowed", "repository_state_grants_authority"],
          "properties": {
            "live_authorization": {"const": false},
            "scientific_interpretation_allowed": {"const": false},
            "repository_state_grants_authority": {"const": false}
          }
        },
        "semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "check": {
      "type": "object",
      "required": ["complete", "semantic_sha256"],
      "properties": {
        "complete": {"type": "boolean"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
