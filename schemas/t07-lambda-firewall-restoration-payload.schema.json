{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-firewall-restoration-payload.schema.json",
  "title": "Private exact Lambda global-firewall restoration payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/firewallRule"}
    }
  },
  "$defs": {
    "firewallRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "source_network", "description"],
      "properties": {
        "protocol": {"enum": ["tcp", "udp", "icmp", "all"]},
        "port_range": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1, "maximum": 65535},
            {"type": "integer", "minimum": 1, "maximum": 65535}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source_network": {"type": "string", "minLength": 1, "maxLength": 18},
        "description": {"type": "string", "minLength": 0, "maxLength": 128}
      },
      "allOf": [
        {
          "if": {"properties": {"protocol": {"const": "icmp"}}, "required": ["protocol"]},
          "then": {"not": {"required": ["port_range"]}},
          "else": {"required": ["port_range"]}
        }
      ]
    }
  }
}
