{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:run-profile:0.1.0",
  "title": "GIC Lab paired run profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "plan_id",
    "profile",
    "study_stage",
    "purpose",
    "sample_rationale",
    "interpretation_allowed",
    "execution",
    "model",
    "sampling",
    "budget",
    "artifacts",
    "condition_plan_paths",
    "readiness"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{4}$"},
    "plan_id": {"type": "string", "pattern": "^PLAN-[A-Z0-9][A-Z0-9._-]{5,127}$"},
    "profile": {"enum": ["smoke", "pilot", "confirmatory"]},
    "study_stage": {"enum": ["exploratory", "confirmatory"]},
    "purpose": {"type": "string", "minLength": 8},
    "sample_rationale": {"type": "string", "minLength": 8},
    "interpretation_allowed": {"type": "boolean"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "authorization_reference"],
      "properties": {
        "authorized": {"type": "boolean"},
        "authorization_reference": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {"properties": {"authorized": {"const": true}}, "required": ["authorized"]},
          "then": {"properties": {"authorization_reference": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"authorization_reference": {"type": "null"}}}
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "manifest_id",
        "api",
        "upstream_alias",
        "proposed_immutable_revision",
        "historical_revision_known",
        "reproduction_level",
        "substitution"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "manifest_id": {"type": "string", "minLength": 1},
        "api": {"type": "string", "format": "uri"},
        "upstream_alias": {"type": "string", "minLength": 1},
        "proposed_immutable_revision": {"type": "string", "minLength": 1},
        "historical_revision_known": {"type": "boolean"},
        "reproduction_level": {
          "enum": [
            "artifact-execution",
            "directional-reproduction",
            "mechanism-reproduction",
            "confirmatory-replication"
          ]
        },
        "substitution": {"type": ["string", "null"], "minLength": 8}
      },
      "allOf": [
        {
          "if": {
            "properties": {"historical_revision_known": {"const": false}},
            "required": ["historical_revision_known"]
          },
          "then": {"properties": {"substitution": {"type": "string", "minLength": 8}}},
          "else": {"properties": {"substitution": {"type": "null"}}}
        }
      ]
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_count",
        "conditions",
        "task_family",
        "dataset_ids",
        "counterbalancing"
      ],
      "properties": {
        "pair_count": {"type": "integer", "minimum": 1},
        "conditions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "task_family": {"type": "string", "minLength": 1},
        "dataset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "counterbalancing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pair_id",
              "task_id",
              "task_source",
              "first",
              "second",
              "plans"
            ],
            "properties": {
              "pair_id": {"type": "string", "minLength": 1},
              "task_id": {"type": "string", "minLength": 1},
              "task_source": {"type": "string", "minLength": 1},
              "first": {"type": "string", "minLength": 1},
              "second": {"type": "string", "minLength": 1},
              "plans": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["condition", "path"],
                  "properties": {
                    "condition": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pricing_record",
        "max_cost_usd",
        "max_model_tokens",
        "max_wall_seconds"
      ],
      "properties": {
        "pricing_record": {"type": "string", "minLength": 1},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "max_model_tokens": {"type": "integer", "minimum": 0},
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "max_model_calls": {"type": "integer", "minimum": 0},
        "max_browser_actions": {"type": "integer", "minimum": 0},
        "max_accelerator_hours": {"type": "number", "minimum": 0},
        "max_provider_compute_cost_usd": {"type": "number", "minimum": 0},
        "max_preflight_provider_compute_cost_usd": {"type": "number", "minimum": 0},
        "max_total_cost_usd": {"type": "number", "minimum": 0},
        "prior_t09_cost_usd": {"type": "number", "minimum": 0},
        "cumulative_t09_cost_cap_usd": {"type": "number", "minimum": 0},
        "condition_limits": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {"$ref": "#/$defs/condition-limit"}
        }
      }
    },
    "provider_lifecycle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_clock_origin",
            "campaign_provider_wall_seconds",
            "normal_cleanup_reserve_seconds",
            "provider_termination_cutoff_seconds",
            "post_condition_evaluator_evidence_seconds",
            "termination_dispatch_margin_seconds",
            "max_lambda_instances",
            "max_launch_count",
            "persistent_filesystems",
            "replacement_launch_rule",
            "admission_rule",
            "control_plane"
          ],
          "properties": {
            "campaign_clock_origin": {
              "const": "provider-launch-send-started-conservative"
            },
            "campaign_provider_wall_seconds": {"const": 14400},
            "normal_cleanup_reserve_seconds": {"const": 900},
            "provider_termination_cutoff_seconds": {"const": 13500},
            "post_condition_evaluator_evidence_seconds": {"const": 600},
            "termination_dispatch_margin_seconds": {"const": 60},
            "max_lambda_instances": {"const": 1},
            "max_launch_count": {"enum": [1, 2]},
            "persistent_filesystems": {"const": 0},
            "replacement_launch_rule": {"$ref": "#/$defs/replacement-launch-rule"},
            "admission_rule": {"type": "string", "minLength": 8},
            "control_plane": {"type": "string", "minLength": 8}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cumulative_accounting_origin",
            "preflight_clock_origin",
            "preflight_wall_seconds",
            "failed_preflight_termination_dispatch_seconds",
            "empirical_clock_origin",
            "empirical_campaign_wall_seconds",
            "empirical_cleanup_reserve_seconds",
            "empirical_termination_cutoff_seconds",
            "maximum_successful_host_active_seconds",
            "maximum_cumulative_active_seconds",
            "max_lambda_instances",
            "max_launch_count",
            "persistent_filesystems",
            "replacement_launch_rule",
            "admission_rule",
            "control_plane"
          ],
          "properties": {
            "cumulative_accounting_origin": {"const": "actual-active-lambda-seconds"},
            "preflight_clock_origin": {"const": "provider-launch-send-started"},
            "preflight_wall_seconds": {"const": 3600},
            "failed_preflight_termination_dispatch_seconds": {"const": 300},
            "empirical_clock_origin": {
              "const": "after-durable-frozen-run-manifest-publication"
            },
            "empirical_campaign_wall_seconds": {"const": 14400},
            "evidence_export_reserve_seconds": {"const": 600},
            "provider_termination_handoff_seconds": {"const": 60},
            "supervised_release_wait_seconds": {"const": 300},
            "supervised_release_rule": {"type": "string", "minLength": 16},
            "empirical_cleanup_reserve_seconds": {"const": 900},
            "empirical_termination_cutoff_seconds": {"const": 13500},
            "maximum_successful_host_active_seconds": {"const": 18000},
            "maximum_cumulative_active_seconds": {"const": 21600},
            "max_lambda_instances": {"const": 1},
            "max_launch_count": {"enum": [1, 2]},
            "persistent_filesystems": {"const": 0},
            "replacement_launch_rule": {"$ref": "#/$defs/replacement-launch-rule"},
            "admission_rule": {"type": "string", "minLength": 8},
            "control_plane": {"type": "string", "minLength": 8}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cumulative_accounting_origin",
            "preflight_clock_origin",
            "preflight_iteration_wall_seconds",
            "maximum_preflight_instance_active_seconds",
            "maximum_cumulative_preflight_active_seconds",
            "maximum_preflight_provider_cost_usd",
            "max_preflight_launch_count",
            "failed_preflight_termination_dispatch_seconds",
            "empirical_clock_origin",
            "empirical_campaign_wall_seconds",
            "empirical_cleanup_reserve_seconds",
            "empirical_termination_cutoff_seconds",
            "maximum_empirical_provider_cost_usd",
            "max_empirical_launch_count",
            "max_lambda_instances",
            "persistent_filesystems",
            "model_metadata_prelaunch_freshness_seconds",
            "model_metadata_freshness_owner",
            "provider_launch_requires_current_freshness",
            "host_runtime_requires_current_freshness",
            "host_runtime_requires_prelaunch_timestamp_ordering",
            "replacement_launch_rule",
            "admission_rule",
            "control_plane"
          ],
          "properties": {
            "cumulative_accounting_origin": {"const": "actual-active-lambda-seconds"},
            "preflight_clock_origin": {"const": "provider-launch-send-started"},
            "preflight_iteration_wall_seconds": {"const": 3600},
            "maximum_preflight_instance_active_seconds": {"const": 21600},
            "maximum_cumulative_preflight_active_seconds": {"const": 43200},
            "maximum_preflight_provider_cost_usd": {"enum": [10.0, 20.0]},
            "max_preflight_launch_count": {"const": 8},
            "failed_preflight_termination_dispatch_seconds": {"const": 300},
            "empirical_clock_origin": {
              "const": "after-durable-frozen-run-manifest-publication"
            },
            "empirical_campaign_wall_seconds": {"const": 14400},
            "evidence_export_reserve_seconds": {"const": 600},
            "provider_termination_handoff_seconds": {"const": 60},
            "supervised_release_wait_seconds": {"const": 300},
            "supervised_release_rule": {"type": "string", "minLength": 16},
            "empirical_cleanup_reserve_seconds": {"const": 900},
            "empirical_termination_cutoff_seconds": {"const": 13500},
            "maximum_empirical_provider_cost_usd": {"const": 8.0},
            "max_empirical_launch_count": {"const": 1},
            "max_lambda_instances": {"const": 1},
            "persistent_filesystems": {"const": 0},
            "immutable_model_unavailable_disposition": {
              "const": "stop-before-lambda-launch-zero-lambda-cost"
            },
            "model_metadata_request_count_total": {"const": 1},
            "model_metadata_request_location": {
              "const": "local-control-plane-before-lambda-launch"
            },
            "provider_launch_model_metadata_request_count": {"const": 0},
            "host_runtime_model_metadata_request_count": {"const": 0},
            "model_metadata_prelaunch_freshness_seconds": {"const": 1800},
            "model_metadata_freshness_owner": {"const": "local-provider-launch-boundary"},
            "provider_launch_requires_current_freshness": {"const": true},
            "host_runtime_requires_current_freshness": {"const": false},
            "host_runtime_requires_prelaunch_timestamp_ordering": {"const": true},
            "model_metadata_receipt_required": {"const": true},
            "model_metadata_receipt_replay_allowed": {"const": false},
            "replacement_launch_rule": {"$ref": "#/$defs/replacement-launch-rule"},
            "admission_rule": {"type": "string", "minLength": 8},
            "control_plane": {"type": "string", "minLength": 8}
          }
        }
      ]
    },
    "replacement_image_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_image_digest",
        "exact_historical_digest_equality_required",
        "candidate_builds_normally",
        "candidate_qualifications_normally",
        "source_inputs",
        "acceptance",
        "freeze_sequence",
        "authoritative_runtime_identity",
        "all_attempts_same_image_required",
        "image_export"
      ],
      "properties": {
        "historical_image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "exact_historical_digest_equality_required": {"const": false},
        "candidate_builds_normally": {"enum": [0, 1]},
        "candidate_qualifications_normally": {"const": 1},
        "source_inputs": {"type": "string", "minLength": 8},
        "acceptance": {"type": "string", "minLength": 8},
        "freeze_sequence": {"type": "string", "minLength": 8},
        "authoritative_runtime_identity": {
          "const": "frozen-run-manifest replacement_image_id"
        },
        "all_attempts_same_image_required": {"const": true},
        "image_export": {"type": "string", "minLength": 8},
        "fallback_build_second_launch_policy": {"type": "string", "minLength": 16}
      }
    },
    "raw_attempt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empirical_authority",
        "next_attempt_gate",
        "downstream_finalizer",
        "offhost_reconstruction",
        "repair_policy",
        "uniform_analysis",
        "aggregate_staging"
      ],
      "properties": {
        "empirical_authority": {"type": "string", "minLength": 8},
        "next_attempt_gate": {"type": "string", "minLength": 8},
        "downstream_finalizer": {"type": "string", "minLength": 8},
        "offhost_reconstruction": {"type": "string", "minLength": 8},
        "repair_policy": {"type": "string", "minLength": 8},
        "uniform_analysis": {"type": "string", "minLength": 8},
        "aggregate_staging": {"type": "string", "minLength": 8}
      }
    },
    "core_dump_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker_ulimit",
        "process_soft_limit",
        "process_hard_limit",
        "scope",
        "preentry_proof",
        "detection",
        "disposition"
      ],
      "properties": {
        "docker_ulimit": {"const": "core=0:0"},
        "process_soft_limit": {"const": 0},
        "process_hard_limit": {"const": 0},
        "scope": {"type": "string", "minLength": 16},
        "preentry_proof": {"type": "string", "minLength": 16},
        "detection": {"type": "string", "minLength": 16},
        "disposition": {"type": "string", "minLength": 16}
      }
    },
    "failure_evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_attempt_cap_bytes",
        "stdout_stderr_per_stream_cap_bytes",
        "essential_failure_cap_bytes",
        "authority",
        "stream_limit_disposition",
        "scientific_status",
        "preempirical_cap_identity",
        "exclusions"
      ],
      "properties": {
        "full_attempt_cap_bytes": {"const": 536870912},
        "stdout_stderr_per_stream_cap_bytes": {"const": 536870912},
        "essential_failure_cap_bytes": {"const": 67108864},
        "authority": {"type": "string", "minLength": 16},
        "stream_limit_disposition": {"type": "string", "minLength": 16},
        "scientific_status": {"type": "string", "minLength": 16},
        "preempirical_cap_identity": {"type": "string", "minLength": 16},
        "exclusions": {"type": "string", "minLength": 16}
      }
    },
    "evidence_cap_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry4_attempt_total_bytes",
        "retry4_core_bytes",
        "retry4_noncore_bytes",
        "retained_attempt_cap_bytes",
        "expected_full_attempt_evidence_bytes",
        "expected_full_attempt_evidence_breakdown",
        "remaining_cap_headroom_bytes",
        "noncore_headroom_ratio",
        "conclusion"
      ],
      "properties": {
        "retry4_attempt_total_bytes": {"const": 236556320},
        "retry4_core_bytes": {"const": 234479616},
        "retry4_noncore_bytes": {"const": 2076704},
        "retained_attempt_cap_bytes": {"const": 536870912},
        "expected_full_attempt_evidence_bytes": {"const": 50331648},
        "expected_full_attempt_evidence_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thirty_screenshots_bytes",
            "session_events_actions_answers_bytes",
            "stdout_stderr_bytes",
            "provider_runtime_cleanup_receipts_bytes",
            "evaluator_schemas_and_manifests_bytes"
          ],
          "properties": {
            "thirty_screenshots_bytes": {"const": 31457280},
            "session_events_actions_answers_bytes": {"const": 8388608},
            "stdout_stderr_bytes": {"const": 4194304},
            "provider_runtime_cleanup_receipts_bytes": {"const": 4194304},
            "evaluator_schemas_and_manifests_bytes": {"const": 2097152}
          }
        },
        "remaining_cap_headroom_bytes": {"const": 486539264},
        "noncore_headroom_ratio": {
          "type": "number",
          "minimum": 258.520,
          "maximum": 258.521
        },
        "conclusion": {"type": "string", "minLength": 16}
      }
    },
    "prior_campaign_disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_id",
            "run_id",
            "status",
            "task_a_simulative",
            "task_b_simulative",
            "task_b_reactive",
            "realized_pair",
            "excluded_from_v7_pairing"
          ],
          "properties": {
            "plan_id": {"const": "PLAN-EXP0001-PILOT-V6"},
            "run_id": {"const": "RUN-T09-TASK-A-REACTIVE-0004"},
            "status": {"const": "consumed-infrastructure-invalid-unscored"},
            "task_a_simulative": {"const": "not-run"},
            "task_b_simulative": {"const": "not-run"},
            "task_b_reactive": {"const": "not-run"},
            "realized_pair": {"const": "none"},
            "excluded_from_v7_pairing": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_id",
            "run_id",
            "status",
            "task_a_reactive",
            "task_a_simulative",
            "task_b_simulative",
            "task_b_reactive",
            "realized_pair",
            "excluded_from_v11_pairing"
          ],
          "properties": {
            "plan_id": {"const": "PLAN-EXP0001-PILOT-V10"},
            "run_id": {"const": "RUN-T09-PILOT-HOST-AUTONOMOUS-0003"},
            "status": {"const": "category_3_v10_stopped_material_failure_cleanup_verified"},
            "task_a_reactive": {"const": "not-run"},
            "task_a_simulative": {"const": "not-run"},
            "task_b_simulative": {"const": "not-run"},
            "task_b_reactive": {"const": "not-run"},
            "realized_pair": {"const": "none"},
            "excluded_from_v11_pairing": {"const": true}
          }
        }
      ]
    },
    "historical_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_plan_id",
        "attempt_run_id",
        "archive_sha256",
        "public_disposition_sha256",
        "use"
      ],
      "properties": {
        "source_plan_id": {"const": "PLAN-EXP0001-PILOT-V4"},
        "attempt_run_id": {"const": "RUN-T09-TASK-A-REACTIVE-0002"},
        "archive_sha256": {
          "const": "63ed19b35bcb4cb62c3796a80a48004937340eb3826f9657a1006e251772255d"
        },
        "public_disposition_sha256": {
          "const": "ecc0e135695e16f68d52b7aa85b70d42b1f1e945f7dd119fb7c7ff0e42fc8231"
        },
        "use": {"type": "string", "minLength": 8}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "retain_raw", "public_release"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "retain_raw": {"const": true},
        "public_release": {"enum": ["blocked-pending-review", "summaries-only"]}
      }
    },
    "condition_plan_paths": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_eligibility",
        "approval_changes_required",
        "unresolved_execution_blockers"
      ],
      "properties": {
        "execution_eligibility": {
          "enum": [
            "eligible-after-authorization",
            "blocked-pending-later-phase-integration",
            "blocked-pending-prerequisites"
          ]
        },
        "approval_changes_required": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unresolved_execution_blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "pre_execution_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        }
      }
    }
  },
  "$defs": {
    "replacement-launch-rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_only_before_empirical_entry",
        "prior_instance_terminal_and_absent_required",
        "prior_host_empirical_attempts_required",
        "prior_host_model_requests_required",
        "prior_host_browser_actions_required",
        "ownership_outcome_unknown_forbidden",
        "cumulative_lambda_cap_required"
      ],
      "properties": {
        "allowed_only_before_empirical_entry": {"const": true},
        "prior_instance_terminal_and_absent_required": {"const": true},
        "prior_host_empirical_attempts_required": {"const": 0},
        "prior_host_model_requests_required": {"const": 0},
        "prior_host_browser_actions_required": {"const": 0},
        "ownership_outcome_unknown_forbidden": {"const": true},
        "cumulative_lambda_cap_required": {"const": true}
      }
    },
    "condition-limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "max_model_calls_per_attempt",
        "max_model_tokens_per_attempt",
        "max_browser_actions_per_attempt",
        "max_wall_seconds_per_attempt",
        "max_openai_cost_usd_per_attempt",
        "max_accelerator_hours_per_attempt"
      ],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "max_model_calls_per_attempt": {"type": "integer", "minimum": 0},
        "max_model_tokens_per_attempt": {"type": "integer", "minimum": 0},
        "max_browser_actions_per_attempt": {"type": "integer", "minimum": 0},
        "max_wall_seconds_per_attempt": {"type": "integer", "minimum": 1},
        "max_openai_cost_usd_per_attempt": {"type": "number", "minimum": 0},
        "max_accelerator_hours_per_attempt": {"type": "number", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "smoke"}}, "required": ["profile"]},
      "then": {"properties": {"interpretation_allowed": {"const": false}}}
    },
    {
      "if": {
        "properties": {
          "profile": {"const": "pilot"},
          "budget": {"required": ["condition_limits"]}
        },
        "required": ["profile", "budget"]
      },
      "then": {
        "properties": {
          "budget": {
            "required": [
              "max_model_calls",
              "max_browser_actions",
              "max_accelerator_hours",
              "max_provider_compute_cost_usd",
              "max_total_cost_usd",
              "condition_limits"
            ]
          }
        }
      }
    }
  ]
}
