{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-l2-watchdog-journal.schema.json",
  "$comment": "Cleanup-only watchdog evidence; this schema never authorizes launch, SSH, or workload execution.",
  "title": "T07 Lambda Gate L2 watchdog-journal event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "authorization_reference",
    "actor",
    "event_sequence",
    "event_type",
    "request_ordinal",
    "resource_alias",
    "private_parameter_seal_reference",
    "monotonic_timestamp_ns",
    "wall_timestamp_utc",
    "elapsed_ms",
    "response_bytes",
    "provider_calls_used",
    "process_calls_used",
    "output_bytes_used",
    "terminal_status",
    "sanitized_failure_class"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"const": "RUN-T07-L2-LAMBDA-HOST-QUALIFICATION-0002"},
    "plan_id": {"const": "PLAN-T07-GATE-L2-LAMBDA-HOST-QUALIFICATION-V2"},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "actor": {"const": "watchdog"},
    "event_sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
    "event_type": {
      "enum": [
        "watchdog_bootstrap_started",
        "watchdog_credential_received",
        "watchdog_ready",
        "primary_heartbeat_observed",
        "primary_heartbeat_stale",
        "primary_term_sent",
        "primary_kill_sent",
        "primary_exit_observed",
        "mutation_lease_acquired",
        "watchdog_discovery_started",
        "watchdog_owned_matches_found",
        "watchdog_provider_intent",
        "watchdog_provider_send_started",
        "watchdog_provider_response_received",
        "watchdog_provider_failed",
        "watchdog_instance_terminal",
        "watchdog_regional_ruleset_deleted",
        "watchdog_global_firewall_restored",
        "watchdog_all_clean",
        "watchdog_incident_sealed",
        "watchdog_stopped"
      ]
    },
    "request_ordinal": {"type": ["integer", "null"], "minimum": 1, "maximum": 420},
    "resource_alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "private_parameter_seal_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "monotonic_timestamp_ns": {"type": "integer", "minimum": 0},
    "wall_timestamp_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 5400000},
    "response_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "provider_calls_used": {"type": "integer", "minimum": 0, "maximum": 420},
    "process_calls_used": {"type": "integer", "minimum": 0, "maximum": 128},
    "output_bytes_used": {"type": "integer", "minimum": 0, "maximum": 100663296},
    "terminal_status": {"type": "string", "minLength": 1, "maxLength": 96},
    "sanitized_failure_class": {"type": ["string", "null"], "pattern": "^[a-z0-9_]{1,96}$"}
  }
}
