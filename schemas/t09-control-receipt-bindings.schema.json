{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t09-control-receipt-bindings.schema.json",
  "title": "T09 validated control-proof binding document",
  "description": "Binds exact control evidence and package identity. This document never grants live authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_slug",
    "base_commit",
    "control_plane_revision",
    "selected_runtime_target",
    "artifacts",
    "authority",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": {"enum": ["4.0.0", "5.0.0"]},
    "repository_slug": {"const": "abbudjoe/gic-lab"},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "control_plane_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "selected_runtime_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "goal_record_path",
        "goal_record_sha256",
        "historical_contract_version",
        "successor_contract_version",
        "successor_status",
        "selected_provider_contract_version",
        "selected_plan_id",
        "selected_command_package_sha256",
        "selected_package_status",
        "authority",
        "semantic_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source": {"enum": ["goal-record", "explicit-provider-contract"]},
        "goal_record_path": {"const": "control/goals/EXP-0001.yaml"},
        "goal_record_sha256": {"$ref": "#/$defs/sha256"},
        "historical_contract_version": {"$ref": "#/$defs/version"},
        "successor_contract_version": {"$ref": "#/$defs/version"},
        "successor_status": {"enum": ["not-created", "package-bound-not-authorized"]},
        "selected_provider_contract_version": {"$ref": "#/$defs/version"},
        "selected_plan_id": {"type": "string", "pattern": "^PLAN-EXP0001-PILOT-V[1-9][0-9]*$"},
        "selected_command_package_sha256": {"$ref": "#/$defs/sha256"},
        "selected_package_status": {"type": "string", "minLength": 1},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live_authorization", "scientific_interpretation_allowed", "repository_state_grants_authority"],
          "properties": {
            "live_authorization": {"const": false},
            "scientific_interpretation_allowed": {"const": false},
            "repository_state_grants_authority": {"const": false}
          }
        },
        "semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "package_effect_registration": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation_path",
            "implementation_bytes",
            "implementation_sha256",
            "factory_entry_point",
            "authority_grant_schema_version",
            "effect_protocol_version"
          ],
          "properties": {
            "implementation_path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.py$"
            },
            "implementation_bytes": {"type": "integer", "minimum": 1},
            "implementation_sha256": {"$ref": "#/$defs/sha256"},
            "factory_entry_point": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "authority_grant_schema_version": {"const": "1.0.0"},
            "effect_protocol_version": {"const": "1.0.0"}
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_record",
        "registry_receipt",
        "active_version_lint_receipt",
        "composition_receipt",
        "state_capsule",
        "shadow_happy_path",
        "shadow_failures",
        "agent_check_receipt",
        "source_binding_receipt",
        "incident_receipt"
      ],
      "properties": {
        "goal_record": {"$ref": "#/$defs/byteArtifact"},
        "registry_receipt": {"$ref": "#/$defs/artifact"},
        "active_version_lint_receipt": {"$ref": "#/$defs/artifact"},
        "composition_receipt": {"$ref": "#/$defs/artifact"},
        "state_capsule": {"$ref": "#/$defs/artifact"},
        "shadow_happy_path": {"$ref": "#/$defs/artifact"},
        "shadow_failures": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/artifact"},
          "minProperties": 1
        },
        "agent_check_receipt": {"$ref": "#/$defs/artifact"},
        "source_binding_receipt": {"$ref": "#/$defs/artifact"},
        "incident_receipt": {"$ref": "#/$defs/artifact"},
        "anti_shadow_lint_receipt": {"$ref": "#/$defs/artifact"},
        "live_effect_conformance_receipt": {"$ref": "#/$defs/artifact"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_authorization",
        "scientific_interpretation_allowed",
        "repository_state_grants_authority"
      ],
      "properties": {
        "live_authorization": {"const": false},
        "scientific_interpretation_allowed": {"const": false},
        "repository_state_grants_authority": {"const": false}
      }
    },
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "5.0.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["package_effect_registration"],
        "properties": {
          "artifacts": {
            "required": [
              "goal_record",
              "registry_receipt",
              "active_version_lint_receipt",
              "composition_receipt",
              "state_capsule",
              "shadow_happy_path",
              "shadow_failures",
              "agent_check_receipt",
              "source_binding_receipt",
              "incident_receipt",
              "anti_shadow_lint_receipt",
              "live_effect_conformance_receipt"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^V[1-9][0-9]*$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "file_sha256", "semantic_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"},
        "bytes": {"type": "integer", "minimum": 2},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "byteArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "file_sha256"],
      "properties": {
        "path": {"const": "bound-goal-record.yaml"},
        "bytes": {"type": "integer", "minimum": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
