{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:sealed-artifact-copy:0.1.0",
  "title": "T07 verified one-way sealed artifact copy record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "archive_id",
    "source_path",
    "destination_path",
    "source_device",
    "destination_device",
    "source_volume_uuid",
    "destination_volume_uuid",
    "copied_at_utc",
    "seal_sha256",
    "destination_seal_sha256",
    "files_verified",
    "total_payload_bytes",
    "source_retained"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "archive_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "source_path": {"type": "string", "pattern": "^/"},
    "destination_path": {"type": "string", "pattern": "^/"},
    "source_device": {"type": "integer", "minimum": 0},
    "destination_device": {"type": "integer", "minimum": 0},
    "source_volume_uuid": {"type": "string", "pattern": "^[A-F0-9-]{36}$"},
    "destination_volume_uuid": {"const": "8478609D-FA37-4ED5-875D-47AE912B9151"},
    "copied_at_utc": {"type": "string", "format": "date-time"},
    "seal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "destination_seal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files_verified": {"type": "integer", "minimum": 0},
    "total_payload_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "source_retained": {"const": true}
  }
}
