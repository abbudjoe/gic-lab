{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:t09-offline-refinalization-receipt:1.0.0",
  "title": "T09 canonical offline-refinalization control receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_schema_sha256",
    "plan_id",
    "host_run_id",
    "run_id",
    "raw_manifest_sha256_before",
    "raw_manifest_sha256_after",
    "raw_receipt_sha256",
    "raw_manifest_payload_sha256",
    "raw_receipt_payload_sha256",
    "output_files",
    "output_files_sha256",
    "outcome_sha256",
    "evidence_index_sha256",
    "semantic_projection_file_sha256",
    "semantic_projection_sha256",
    "finalizer_closure",
    "finalizer_dependency_manifest_sha256",
    "interpreter",
    "interpreter_sha256",
    "network",
    "additional_model_calls",
    "additional_browser_actions",
    "raw_source_mutated",
    "output_schema_valid",
    "canonical_control",
    "canonical_control_sha256",
    "nonsemantic_fields"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "plan_id": {"$ref": "#/$defs/safeIdentity"},
    "host_run_id": {"$ref": "#/$defs/safeIdentity"},
    "run_id": {"$ref": "#/$defs/safeIdentity"},
    "raw_manifest_sha256_before": {"$ref": "#/$defs/sha256"},
    "raw_manifest_sha256_after": {"$ref": "#/$defs/sha256"},
    "raw_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "raw_manifest_payload_sha256": {"$ref": "#/$defs/sha256"},
    "raw_receipt_payload_sha256": {"$ref": "#/$defs/sha256"},
    "output_files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/fileIdentity"}
    },
    "output_files_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_index_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_projection_file_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_projection_sha256": {"$ref": "#/$defs/sha256"},
    "finalizer_closure": {"$ref": "#/$defs/finalizerClosure"},
    "finalizer_dependency_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "interpreter": {"$ref": "#/$defs/absolutePath"},
    "interpreter_sha256": {"$ref": "#/$defs/sha256"},
    "network": {"enum": ["none", "socket-construction-denied"]},
    "additional_model_calls": {"const": 0},
    "additional_browser_actions": {"const": 0},
    "raw_source_mutated": {"const": false},
    "output_schema_valid": {"const": true},
    "canonical_control": {
      "type": "object",
      "required": [
        "receipt_schema_version",
        "raw_attempt_identity",
        "raw_attempt_manifest_public_alias",
        "raw_attempt_manifest_sha256",
        "raw_manifest_validation",
        "frozen_scientific_commit",
        "frozen_run_manifest_sha256",
        "attempt_id",
        "task_id",
        "task_sha256",
        "condition",
        "finalizer_source_commit",
        "finalizer_source_sha256",
        "selector_source_sha256",
        "projection_source_sha256",
        "absolute_interpreter_identity",
        "python_version",
        "dependency_closure_identity",
        "evaluator_commit",
        "scoring_contract_identity",
        "network_disabled",
        "network_policy",
        "model_replay_count",
        "browser_replay_count",
        "raw_mutation",
        "output_semantic_projection_sha256",
        "finalization_terminal_state"
      ],
      "properties": {
        "receipt_schema_version": {"const": "1.0.0"},
        "raw_attempt_identity": {"$ref": "#/$defs/sha256"},
        "raw_attempt_manifest_public_alias": {"$ref": "#/$defs/relativePath"},
        "raw_attempt_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "raw_manifest_validation": {"const": "validated-before-and-after-byte-identical"},
        "frozen_scientific_commit": {"$ref": "#/$defs/commit"},
        "frozen_run_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "attempt_id": {"$ref": "#/$defs/safeIdentity"},
        "task_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "condition": {"enum": ["reactive", "simulative"]},
        "finalizer_source_commit": {"$ref": "#/$defs/commit"},
        "finalizer_source_sha256": {"$ref": "#/$defs/sha256"},
        "selector_source_sha256": {"$ref": "#/$defs/sha256"},
        "projection_source_sha256": {"$ref": "#/$defs/sha256"},
        "absolute_interpreter_identity": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/absolutePath"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "python_version": {"const": "3.11.14"},
        "dependency_closure_identity": {"$ref": "#/$defs/sha256"},
        "evaluator_commit": {"const": "93fb8d72de71f9a4a13419670adeb34d93cf7acd"},
        "scoring_contract_identity": {"$ref": "#/$defs/sha256"},
        "network_disabled": {"const": true},
        "network_policy": {"enum": ["none", "socket-construction-denied"]},
        "model_replay_count": {"const": 0},
        "browser_replay_count": {"const": 0},
        "raw_mutation": {"const": false},
        "output_semantic_projection_sha256": {"$ref": "#/$defs/sha256"},
        "finalization_terminal_state": {"const": "offline-refinalization-complete"}
      },
      "additionalProperties": false
    },
    "canonical_control_sha256": {"$ref": "#/$defs/sha256"},
    "nonsemantic_fields": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "safeIdentity": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "fileIdentity": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "finalizerClosure": {
      "type": "object",
      "required": [
        "finalizer_execution_mode",
        "finalizer_runtime_qualification_sha256",
        "finalizer_commit",
        "finalizer_source_sha256",
        "finalizer_projection_source_sha256",
        "selector_source_sha256",
        "scientific_package_commit",
        "pilot_library_sha256",
        "interpreter",
        "interpreter_sha256",
        "python_version",
        "interpreter_dependency_manifest_sha256",
        "replacement_image_id",
        "execution_contract_sha256",
        "command_manifests_sha256",
        "dataset_contract_sha256",
        "evaluator_contract_sha256",
        "evaluator_commit",
        "score_schema_sha256",
        "evidence_schema_sha256",
        "refinalization_receipt_schema_sha256",
        "evaluator_overlay_entries_sha256",
        "evaluator_overlay_packages_sha256"
      ],
      "properties": {
        "finalizer_execution_mode": {"enum": ["qualified-image", "qualified-local"]},
        "finalizer_runtime_qualification_sha256": {"$ref": "#/$defs/sha256"},
        "finalizer_commit": {"$ref": "#/$defs/commit"},
        "finalizer_source_sha256": {"$ref": "#/$defs/sha256"},
        "finalizer_projection_source_sha256": {"$ref": "#/$defs/sha256"},
        "selector_source_sha256": {"$ref": "#/$defs/sha256"},
        "scientific_package_commit": {"$ref": "#/$defs/commit"},
        "pilot_library_sha256": {"$ref": "#/$defs/sha256"},
        "interpreter": {"$ref": "#/$defs/absolutePath"},
        "interpreter_sha256": {"$ref": "#/$defs/sha256"},
        "python_version": {"const": "3.11.14"},
        "interpreter_dependency_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "replacement_image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "execution_contract_sha256": {"$ref": "#/$defs/sha256"},
        "command_manifests_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_contract_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_contract_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_commit": {"const": "93fb8d72de71f9a4a13419670adeb34d93cf7acd"},
        "score_schema_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
        "refinalization_receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_overlay_entries_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_overlay_packages_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
