{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t09-control-composition-receipt.schema.json",
  "title": "T09 offline control composition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_commit",
    "repository_tree",
    "provider_contract_version",
    "provider_contract_sha256",
    "provider_profile_sha256",
    "lifecycle_sha256",
    "execution_contract_sha256",
    "command_package_sha256",
    "pair_diff_sha256s",
    "metadata_policy",
    "replacement_policy",
    "cleanup_family",
    "command_package_family",
    "downstream_source_contract_sha256",
    "privacy_contract_sha256",
    "budget_envelope_sha256",
    "evidence_identity_sha256",
    "authorization_schema_sha256",
    "control_binding_schema_sha256",
    "target_schema_sha256",
    "registry_receipt_sha256",
    "version_lint_receipt_sha256",
    "blockers",
    "static_composition_valid",
    "ready_for_shadow",
    "ready_for_authenticated_preflight",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repository_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|unknown)$"},
    "repository_tree": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|unknown)$"},
    "provider_contract_version": {"type": "string", "pattern": "^V[0-9]+$"},
    "provider_contract_sha256": {"$ref": "#/$defs/sha256"},
    "provider_profile_sha256": {"$ref": "#/$defs/sha256"},
    "lifecycle_sha256": {"$ref": "#/$defs/sha256"},
    "execution_contract_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "command_package_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "pair_diff_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
    "metadata_policy": {"enum": ["none", "local-prelaunch-receipt"]},
    "replacement_policy": {"enum": ["none", "bounded-preflight"]},
    "cleanup_family": {"enum": ["historical", "early-journal", "empirical-prefix"]},
    "command_package_family": {"enum": ["historical", "autonomous"]},
    "downstream_source_contract_sha256": {"$ref": "#/$defs/sha256"},
    "privacy_contract_sha256": {"$ref": "#/$defs/sha256"},
    "budget_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_identity_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_schema_sha256": {"$ref": "#/$defs/sha256"},
    "control_binding_schema_sha256": {"$ref": "#/$defs/sha256"},
    "target_schema_sha256": {"$ref": "#/$defs/sha256"},
    "registry_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "version_lint_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "static_composition_valid": {"const": true},
    "ready_for_shadow": {"type": "boolean"},
    "ready_for_authenticated_preflight": {"const": false},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
