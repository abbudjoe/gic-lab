        "ssh_sessions": {"type": "integer", "minimum": 0, "maximum": 2},
        "remote_commands": {"type": "integer", "minimum": 0, "maximum": 48},
        "ssh_command_output_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "docker_calls": {"type": "integer", "minimum": 0, "maximum": 32},
        "docker_output_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "registry_response_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "docker_disk_delta_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "fixture_output_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "remote_evidence_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "transfer_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "mac_active_evidence_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "sealed_copy_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "ssh_transfer_calls": {"const": 1},
        "archive_copy_calls": {"const": 1},
        "allocated_accelerator_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "allocated_accelerator_hours": {"$ref": "#/$defs/rational_hours"}
      }
    },
    "compute_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "record_id", "run_id", "append_only", "terminal_reconciled", "estimated_list_cost_cents", "allocated_accelerator_hours", "manifest_sha256"],
      "properties": {
        "path": {"const": "manifests/compute.yaml"},
        "record_id": {"$ref": "#/$defs/nonempty"},
        "run_id": {"type": "string", "pattern": "^RUN-T07-L2-[A-Z0-9._-]+$"},
        "append_only": {"const": true},
        "terminal_reconciled": {"const": true},
        "estimated_list_cost_cents": {"type": "integer", "minimum": 0, "maximum": 150},
        "allocated_accelerator_hours": {"$ref": "#/$defs/rational_hours"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha256_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 4096},
    "launch_tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"$ref": "#/$defs/nonempty"},
        "value": {"type": "string", "maxLength": 128}
      }
    },
    "launch_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_name",
        "instance_type_name",
        "ssh_key_names",
        "file_system_names",
        "file_system_mounts",
        "name",
        "image",
        "tags",
        "firewall_rulesets"
      ],
      "properties": {
        "region_name": {"$ref": "#/$defs/nonempty"},
        "instance_type_name": {"$ref": "#/$defs/nonempty"},
        "ssh_key_names": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
        "file_system_names": {"type": "array", "maxItems": 0},
        "file_system_mounts": {"type": "array", "maxItems": 0},
        "name": {"const": "giclab-t07-l2-qualification"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {"id": {"$ref": "#/$defs/nonempty"}}
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"const": "giclab.experiment"}, "value": {"const": "EXP-0001"}}},
            {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"const": "giclab.gate"}, "value": {"const": "T07-L2"}}},
            {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"const": "giclab.authorization"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}}
          ],
          "items": false
        },
        "firewall_rulesets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {"id": {"$ref": "#/$defs/nonempty"}}
          }
        }
      }
    },
    "containment_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "gate", "attempt", "authorization", "image_manifest", "repository_commit", "provider_instance_id", "fixture_sha256"],
      "properties": {
        "experiment": {"const": "EXP-0001"},
        "gate": {"const": "T07-L2"},
        "attempt": {"$ref": "#/$defs/nonempty"},
        "authorization": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "image_manifest": {"const": "sha256:7a3ebe5bfd1a4a19797d20b0c0bb39d44393e9a03fd852c0865b0f540d868df0"},
        "repository_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "provider_instance_id": {"$ref": "#/$defs/nonempty"},
        "fixture_sha256": {"const": "09838913b14d23da939225cb89411619e91cb9ee023a2721b5b7c3890ac90aea"}
      }
    },
    "applet_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "required_applets", "all_required_present", "verification_marker", "fixture_source_sha256"],
      "properties": {
        "command": {"const": ["/bin/busybox", "--list"]},
        "required_applets": {"const": ["sh", "setsid", "sleep", "ps", "kill"]},
        "all_required_present": {"const": true},
        "verification_marker": {"const": "T07_APPLETS_VERIFIED=sh,setsid,sleep,ps,kill"},
        "fixture_source_sha256": {"const": "09838913b14d23da939225cb89411619e91cb9ee023a2721b5b7c3890ac90aea"}
      }
    },
    "pre_stop_process_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "capture_method",
        "docker_top_sha256",
        "fixture_log_sha256",
        "container_exec_calls",
        "process_count",
        "child_observed",
        "grandchild_observed",
        "setsid_observed",
        "reparent_observed",
        "term_ignored_observed",
        "pid_limit_observed",
        "container_init_pid_1_observed"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "capture_method": {"const": "docker-top-plus-fixture-log-no-exec"},
        "docker_top_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_log_sha256": {"$ref": "#/$defs/sha256"},
        "container_exec_calls": {"const": 0},
        "process_count": {"type": "integer", "minimum": 3, "maximum": 64},
        "child_observed": {"const": true},
        "grandchild_observed": {"const": true},
        "setsid_observed": {"const": true},
        "reparent_observed": {"const": true},
        "term_ignored_observed": {"const": true},
        "pid_limit_observed": {"const": true},
        "container_init_pid_1_observed": {"const": true}
      }
    },
    "rational_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0, "maximum": 3600},
        "denominator": {"const": 3600}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle_state": {"const": "terminal-confirmed"}}},
      "then": {
        "properties": {
          "termination": {
            "properties": {
              "terminal_state": {"const": "terminated"},
              "provider_nonbillable_confirmed": {"const": true}
            }
          }
        }
      }
    }
  ]
}
