{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t09-active-version-lint-receipt.schema.json",
  "title": "T09 active-version AST lint receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_commit",
    "repository_tree",
    "scan_roots",
    "files_scanned",
    "historical_module_allowlist",
    "findings",
    "complete",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repository_commit": {"$ref": "#/$defs/git"},
    "repository_tree": {"$ref": "#/$defs/git"},
    "scan_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "files_scanned": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.py$"}
    },
    "historical_module_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.py$"}
    },
    "findings": {
      "type": "array",
      "items": {"type": "object"}
    },
    "complete": {"type": "boolean"},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "git": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
