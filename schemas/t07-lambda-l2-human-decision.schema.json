{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-l2-human-decision.schema.json",
  "title": "T07 Gate L2 private human decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "decision_nonce",
    "selected_instance_type",
    "selected_region",
    "selected_image_alias",
    "expected_image_version",
    "selected_ssh_key_name",
    "ssh_private_access_mode",
    "firewall_strategy",
    "source_ipv4_cidr",
    "attest_no_other_workspace_resource_depends_on_current_global_inbound_rules_during_window",
    "host_key_trust_method",
    "max_provider_wall_seconds",
    "max_provider_cost_usd",
    "max_host_key_checkpoint_seconds",
    "persistent_filesystem",
    "approve_unique_ssh_key_match",
    "approve_no_persistent_filesystem",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "decision_id": {
      "type": "string",
      "pattern": "^T07-[A-Z0-9._-]{3,63}$"
    },
    "decision_nonce": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_instance_type": {"const": "gpu_1x_a10"},
    "selected_region": {"const": "us-east-1"},
    "selected_image_alias": {"const": "img-0111"},
    "expected_image_version": {"const": "22.4.5-2141"},
    "selected_ssh_key_name": {"const": "fractal-lambda-codex"},
    "ssh_private_access_mode": {"const": "preloaded-ssh-agent"},
    "firewall_strategy": {
      "const": "temporary-global-ssh-only-plus-regional-ssh-only"
    },
    "source_ipv4_cidr": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
    },
    "attest_no_other_workspace_resource_depends_on_current_global_inbound_rules_during_window": {
      "const": true
    },
    "host_key_trust_method": {
      "const": "lambda-jupyter-independent-ed25519-fingerprint"
    },
    "max_provider_wall_seconds": {"const": 3600},
    "max_provider_cost_usd": {"const": 2.0},
    "max_host_key_checkpoint_seconds": {"const": 600},
    "persistent_filesystem": {"type": "null"},
    "approve_unique_ssh_key_match": {"const": true},
    "approve_no_persistent_filesystem": {"const": true},
    "notes": {"type": "string", "maxLength": 2048}
  }
}
