{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:transition:0.1.0",
  "title": "GIC Lab agent transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "experiment_id",
    "episode_id",
    "step_index",
    "timestamp",
    "goal",
    "observation_before",
    "belief_before",
    "configurator_decision",
    "candidate_actions",
    "predicted_futures",
    "selected_plan",
    "executed_action",
    "execution_result",
    "observation_after",
    "belief_after",
    "outcome",
    "reward",
    "cost",
    "model_revision",
    "tool_revisions",
    "environment_revision"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "transition_id": {"type": "string", "pattern": "^TRN-[A-Za-z0-9._-]+$"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{4}$"},
    "episode_id": {"type": "string", "minLength": 1},
    "step_index": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "goal": {"type": "object"},
    "observation_before": {"type": "object"},
    "belief_before": {"type": "object"},
    "configurator_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "budget"],
      "properties": {
        "mode": {"enum": ["act", "plan", "continue-plan", "replan", "revise-goal", "update-identity", "learn", "abstain"]},
        "budget": {"type": "object"}
      }
    },
    "candidate_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_action_id", "action"],
        "properties": {
          "candidate_action_id": {"type": "string", "minLength": 1},
          "action": {"type": "object"}
        }
      }
    },
    "predicted_futures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prediction_id", "candidate_action_id", "horizon", "predicted_state", "confidence"],
        "properties": {
          "prediction_id": {"type": "string", "minLength": 1},
          "candidate_action_id": {"type": "string", "minLength": 1},
          "horizon": {"type": "integer", "minimum": 1},
          "predicted_state": {"type": "object"},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "selected_plan": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_id", "candidate_action_ids"],
          "properties": {
            "plan_id": {"type": "string", "minLength": 1},
            "candidate_action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      ]
    },
    "executed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_action_id", "action"],
      "properties": {
        "candidate_action_id": {"type": ["string", "null"]},
        "action": {"type": "object"}
      }
    },
    "execution_result": {"type": "object"},
    "observation_after": {"type": "object"},
    "belief_after": {"type": "object"},
    "outcome": {"type": "object"},
    "reward": {"type": ["number", "null"]},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_tokens", "model_calls", "tool_calls", "latency_seconds", "accelerator_seconds"],
      "properties": {
        "model_tokens": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "latency_seconds": {"type": "number", "minimum": 0},
        "accelerator_seconds": {"type": "number", "minimum": 0}
      }
    },
    "model_revision": {"type": "string", "minLength": 1},
    "tool_revisions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environment_revision": {"type": "string", "minLength": 1}
  }
}
