{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.example/schemas/t09-host-phase-receipt.schema.json",
  "title": "T09 host phase receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "binding",
    "previous_phase_receipt_sha256",
    "request_semantic_sha256",
    "started_wall_time",
    "completed_wall_time",
    "started_monotonic",
    "completed_monotonic",
    "phase_outputs",
    "phase_output_sha256s",
    "cleanup_state_sha256",
    "model_request_count",
    "browser_action_count",
    "condition_entry_count",
    "network_effects_performed",
    "complete",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {
      "enum": [
        "host-transfer-verify",
        "host-preflight",
        "host-qualify",
        "host-freeze",
        "host-cleanup"
      ]
    },
    "binding": {"$ref": "t09-host-phase-request.schema.json#/$defs/binding"},
    "previous_phase_receipt_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "request_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "started_wall_time": {"type": "number", "minimum": 0},
    "completed_wall_time": {"type": "number", "minimum": 0},
    "started_monotonic": {"type": "number", "minimum": 0},
    "completed_monotonic": {"type": "number", "minimum": 0},
    "phase_outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null", "object", "array"]}
    },
    "phase_output_sha256s": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "cleanup_state_sha256": {"$ref": "#/$defs/sha256"},
    "model_request_count": {"const": 0},
    "browser_action_count": {"const": 0},
    "condition_entry_count": {"const": 0},
    "network_effects_performed": {"type": "integer", "minimum": 0},
    "complete": {"const": true},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
