{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:t09-sira-pilot-evidence:0.3.0",
  "title": "T09 SiRA calibration-pilot reconstructable attempt evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "execution_contract_sha256",
    "identity",
    "runtime",
    "timing",
    "command",
    "provider_calls",
    "browser_actions",
    "retained_artifacts",
    "outcome",
    "evaluator",
    "cleanup",
    "h2k_optional_fields",
    "redaction"
  ],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "plan_id": {"const": "PLAN-EXP0001-PILOT-V5"},
    "execution_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "task_id", "task_text_sha256", "reference_sha256", "pair_id", "order_index", "condition", "attempt"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^RUN-T09-TASK-[AB]-(?:REACTIVE|SIMULATIVE)-0003$"},
        "task_id": {"enum": ["7dcbbbdc7f1120cd", "2120afba8009bad3"]},
        "task_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reference_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pair_id": {"enum": ["PAIR-EXP0001-PILOT-V5-TASK-A", "PAIR-EXP0001-PILOT-V5-TASK-B"]},
        "order_index": {"enum": [1, 2]},
        "condition": {"enum": ["SIRA-REACTIVE", "SIRA-SIMULATIVE"]},
        "attempt": {"const": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["giclab_commit", "finalizer_commit", "finalizer_source_sha256", "finalizer_projection_source_sha256", "finalizer_execution_mode", "finalizer_runtime_qualification_sha256", "finalizer_dependency_manifest_sha256", "reviewed_implementation_ancestor", "sira_commit", "python_version", "python_interpreter_path", "python_interpreter_sha256", "container_image_digest", "frozen_run_manifest_sha256", "qualification_id", "build_context_manifest_sha256", "installed_package_manifest_sha256", "chromium_executable_sha256", "patched_upstream_runner_sha256", "evaluator_overlay_manifest_sha256", "evaluator_overlay_entries_sha256", "evaluator_overlay_packages_sha256", "model_revision", "requested_service_tier", "returned_service_tiers", "browser_identity", "gpu_accounting"],
      "properties": {
        "giclab_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "finalizer_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "finalizer_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "finalizer_projection_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "finalizer_execution_mode": {"enum": ["qualified-image", "qualified-local"]},
        "finalizer_runtime_qualification_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "finalizer_dependency_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewed_implementation_ancestor": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "sira_commit": {"const": "93fb8d72de71f9a4a13419670adeb34d93cf7acd"},
        "python_version": {"enum": ["3.11.14", null]},
        "python_interpreter_path": {"const": "/opt/sira/.venv/bin/python"},
        "python_interpreter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "container_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "frozen_run_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "qualification_id": {"const": "QUAL-T09-PILOT-V5-IMAGE-0001"},
        "build_context_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "installed_package_manifest_sha256": {"const": "4ff2603fa5e0f7033ba773decdcb86abf648dcce22e469d26bc48214e390e104"},
        "chromium_executable_sha256": {"const": "0498f208c25339f386413ada7b3c35293b0b6250e67d85446ba9541d7fd636f7"},
        "patched_upstream_runner_sha256": {"const": "b06793ad1b366a934b798f9f3272fc80a7104a220cb3304ab3bda2eb2a78b331"},
        "evaluator_overlay_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluator_overlay_entries_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluator_overlay_packages_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "model_revision": {"const": "gpt-4o-2024-11-20"},
        "requested_service_tier": {"const": "default"},
        "returned_service_tiers": {"type": "array", "uniqueItems": true, "items": {"const": "default"}},
        "browser_identity": {"type": "object"},
        "gpu_accounting": {"type": "object"}
      },
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "stopped_at", "wall_seconds"],
      "properties": {
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "stopped_at": {"type": ["string", "null"], "format": "date-time"},
        "wall_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 3600}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "argv_sha256", "condition_config_sha256"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "argv_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "condition_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provider_calls": {
      "type": "array",
      "maxItems": 1155,
      "items": {
        "type": "object",
        "required": ["event_id", "parent_event_id", "role", "request_model", "requested_service_tier", "returned_service_tier", "usage", "receipt"],
        "properties": {
          "event_id": {"type": "string"},
          "parent_event_id": {"type": ["string", "null"]},
          "role": {"enum": ["default", "encoder", "memory", "policy", "world_model", "critic", "actor", "fallback"]},
          "request_model": {"const": "gpt-4o-2024-11-20"},
          "requested_service_tier": {"const": "default"},
          "returned_service_tier": {"const": "default"},
          "usage": {"type": "object"},
          "receipt": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "browser_actions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_event_id", "parent_event_id", "requested_action", "result_event_id", "post_action_result", "screenshot_sha256"],
        "properties": {
          "action_event_id": {"type": "string"},
          "parent_event_id": {"type": ["string", "null"]},
          "requested_action": {"type": "string"},
          "result_event_id": {"type": "string"},
          "post_action_result": {"type": "object"},
          "screenshot_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "retained_artifacts": {
      "type": "object",
      "required": ["session_json", "raw_answer", "stdout", "stderr", "screenshots", "normalized_events", "regulation_decisions", "provider_ledger", "raw_attempt_manifest", "raw_attempt_receipt", "evaluator_input", "evaluator_output"],
      "additionalProperties": true
    },
    "outcome": {"$ref": "t09-sira-pilot-score.schema.json"},
    "evaluator": {
      "type": "object",
      "required": ["run_id", "input_sha256", "output_sha256", "valid"],
      "additionalProperties": true
    },
    "cleanup": {
      "type": "object",
      "required": ["browser_closed", "container_removed", "secret_removed", "receipt_sha256"],
      "additionalProperties": true
    },
    "h2k_optional_fields": {
      "type": "object",
      "required": ["availability", "scientific_effect_on_exp0001"],
      "properties": {
        "availability": {"enum": ["retained-when-present", "unavailable-explicitly-null"]},
        "scientific_effect_on_exp0001": {"const": "none"}
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["structural_policy", "secret_values_retained", "private_network_values_public"],
      "properties": {
        "structural_policy": {"const": "t09-structural-sensitive-field-v1"},
        "secret_values_retained": {"const": false},
        "private_network_values_public": {"const": false}
      },
      "additionalProperties": true
    }
  }
}
