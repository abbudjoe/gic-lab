{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/agent-state-capsule.schema.json",
  "title": "GIC Lab agent state capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_policy",
    "generated_at",
    "repository",
    "terminal_goal",
    "current_subgoal",
    "next_technical_subgoal",
    "science",
    "control_plane",
    "runtime_package",
    "selected_runtime_target",
    "authority",
    "resources",
    "evidence",
    "cost",
    "blocking_incident",
    "external_governance_gate",
    "available_actions",
    "recommended_action",
    "provenance",
    "uncertainties",
    "machine_readable_flags",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "generated_at_policy": {"enum": ["deterministic-fixed", "caller-supplied-or-wall-clock"]},
    "generated_at": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "terminal_goal": {"const": "evaluate simulative versus reactive SiRA"},
    "current_subgoal": {"type": "string", "minLength": 1},
    "next_technical_subgoal": {"const": "generate-package-only-v17-after-governance"},
    "science": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific_contract_id", "status", "interpretation_allowed", "interpretation_boundary"],
      "properties": {
        "scientific_contract_id": {"const": "EXP-0001"},
        "status": {"const": "unchanged"},
        "interpretation_allowed": {"const": false},
        "interpretation_boundary": {"type": "string", "minLength": 1}
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "status", "registry_complete", "composition_valid", "active_version_lint_valid", "shadow_happy_path", "failure_matrix_valid"],
      "properties": {
        "revision": {"const": "T09-control-target-selection"},
        "status": {
          "enum": [
            "implementation-complete-external-governance",
            "successor-package-bound-not-authorized"
          ]
        },
        "registry_complete": {"type": "boolean"},
        "composition_valid": {"type": "boolean"},
        "active_version_lint_valid": {"type": "boolean"},
        "shadow_happy_path": {"type": "boolean"},
        "failure_matrix_valid": {"type": "boolean"}
      }
    },
    "runtime_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical_package", "historical_status", "next_package", "next_status"],
      "properties": {
        "historical_package": {"type": "string", "pattern": "^V[0-9]+$"},
        "historical_status": {"type": "string", "minLength": 1},
        "next_package": {"type": "string", "pattern": "^V[0-9]+$"},
        "next_status": {
          "enum": [
            "not-created",
            "package-bound-not-authorized"
          ]
        }
      }
    },
    "selected_runtime_target": {"$ref": "#/$defs/target"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_permissions", "category_3", "current_turn_authority", "inferable_from_repository"],
      "properties": {
        "repository_permissions": {"const": false},
        "category_3": {"const": false},
        "current_turn_authority": {"const": "external-and-not-present"},
        "inferable_from_repository": {"const": false}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_provider_instances", "live_inspection_performed", "provider_absence_basis", "security_restored"],
      "properties": {
        "active_provider_instances": {"const": 0},
        "live_inspection_performed": {"const": false},
        "provider_absence_basis": {"const": "retained-sanitized-v16-evidence"},
        "security_restored": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "science_unchanged", "shadow_classification"],
      "properties": {
        "state": {"const": "control-plane-only"},
        "science_unchanged": {"const": true},
        "shadow_classification": {"const": "non-scientific-control-output"}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cumulative_t09_usd", "stabilization_openai_usd", "stabilization_provider_usd"],
      "properties": {
        "cumulative_t09_usd": {"const": "36.36170860803283125"},
        "stabilization_openai_usd": {"const": "0.00"},
        "stabilization_provider_usd": {"const": "0.00"}
      }
    },
    "blocking_incident": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^INC-[A-Z0-9-]+$"}
      ]
    },
    "external_governance_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "repository_state_grants_authority"],
      "properties": {
        "kind": {"const": "independent-exact-head-review-and-explicit-merge-authorization"},
        "state": {"const": "consult-external-state"},
        "repository_state_grants_authority": {"const": false}
      }
    },
    "available_actions": {"$ref": "#/$defs/stringArray"},
    "recommended_action": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/$defs/stringArray"},
    "uncertainties": {"$ref": "#/$defs/stringArray"},
    "machine_readable_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_authorization", "scientific_interpretation", "live_resources_observed_in_this_work"],
      "properties": {
        "live_authorization": {"const": false},
        "scientific_interpretation": {"const": false},
        "live_resources_observed_in_this_work": {"const": false}
      }
    },
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringArray": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "goal_record_path",
        "goal_record_sha256",
        "historical_contract_version",
        "successor_contract_version",
        "successor_status",
        "selected_provider_contract_version",
        "selected_plan_id",
        "selected_command_package_sha256",
        "selected_package_status",
        "authority",
        "semantic_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source": {"enum": ["goal-record", "explicit-provider-contract"]},
        "goal_record_path": {"const": "control/goals/EXP-0001.yaml"},
        "goal_record_sha256": {"$ref": "#/$defs/sha256"},
        "historical_contract_version": {"$ref": "#/$defs/version"},
        "successor_contract_version": {"$ref": "#/$defs/version"},
        "successor_status": {"enum": ["not-created", "package-bound-not-authorized"]},
        "selected_provider_contract_version": {"$ref": "#/$defs/version"},
        "selected_plan_id": {"type": "string", "pattern": "^PLAN-EXP0001-PILOT-V[1-9][0-9]*$"},
        "selected_command_package_sha256": {"$ref": "#/$defs/sha256"},
        "selected_package_status": {"type": "string", "minLength": 1},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live_authorization", "scientific_interpretation_allowed", "repository_state_grants_authority"],
          "properties": {
            "live_authorization": {"const": false},
            "scientific_interpretation_allowed": {"const": false},
            "repository_state_grants_authority": {"const": false}
          }
        },
        "semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "version": {"type": "string", "pattern": "^V[1-9][0-9]*$"}
  }
}
