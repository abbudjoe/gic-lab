{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:t09-v16-model-metadata-receipt:1.0.0",
  "title": "T09 V16 single pre-launch model-metadata receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "authorization_reference",
    "authorization_source_sha256",
    "authorization_overlay_sha256",
    "repository_commit",
    "repository_tree",
    "plan_id",
    "plan_sha256",
    "provider_contract_version",
    "host_run_id",
    "model_endpoint",
    "requested_model_id",
    "returned_model_id",
    "http_status",
    "request_count",
    "redirect_count",
    "retry_count",
    "pagination_count",
    "request_started_at",
    "response_completed_at",
    "receipt_created_at",
    "response_body_sha256",
    "public_price_contract_sha256",
    "public_deprecation_observation_sha256",
    "terminal_state"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_type": {"const": "t09-model-metadata-prelaunch"},
    "authorization_reference": {"type": "string", "pattern": "^AUTH-T09-V16-[A-Za-z0-9._:-]+$"},
    "authorization_source_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_overlay_sha256": {"$ref": "#/$defs/sha256"},
    "repository_commit": {"$ref": "#/$defs/commit"},
    "repository_tree": {"$ref": "#/$defs/tree"},
    "plan_id": {"const": "PLAN-EXP0001-PILOT-V16"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "provider_contract_version": {"const": "V16"},
    "host_run_id": {"const": "RUN-T09-PILOT-HOST-AUTONOMOUS-0009"},
    "model_endpoint": {"const": "https://api.openai.com/v1/models/gpt-4o-2024-11-20"},
    "requested_model_id": {"const": "gpt-4o-2024-11-20"},
    "returned_model_id": {"const": "gpt-4o-2024-11-20"},
    "http_status": {"const": 200},
    "request_count": {"const": 1},
    "redirect_count": {"const": 0},
    "retry_count": {"const": 0},
    "pagination_count": {"const": 0},
    "request_started_at": {"type": "string", "format": "date-time"},
    "response_completed_at": {"type": "string", "format": "date-time"},
    "receipt_created_at": {"type": "string", "format": "date-time"},
    "response_body_sha256": {"$ref": "#/$defs/sha256"},
    "public_price_contract_sha256": {"$ref": "#/$defs/sha256"},
    "public_deprecation_observation_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_state": {"const": "model-metadata-verified"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}
