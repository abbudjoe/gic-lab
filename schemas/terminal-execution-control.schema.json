{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.local/schemas/terminal-execution-control.schema.json",
  "title": "Terminal execution-control overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_id",
    "experiment_id",
    "effective_on",
    "terminal_record",
    "terminal_state",
    "execution_eligibility",
    "authorized",
    "replayable",
    "supersedes_registered_profile_readiness",
    "superseded_registered_profiles",
    "superseded_execution_contracts",
    "blockers",
    "successor"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "control_id": {
      "type": "string",
      "pattern": "^EXECUTION-CONTROL-[A-Z0-9][A-Z0-9._-]{5,127}$"
    },
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{4}$"},
    "effective_on": {"type": "string", "format": "date"},
    "terminal_record": {"$ref": "#/$defs/path_hash"},
    "terminal_state": {"const": "t09-pilot-blocked-material-risk"},
    "empirical_entry": {"type": "boolean"},
    "execution_eligibility": {"const": "blocked-pending-prerequisites"},
    "authorized": {"const": false},
    "replayable": {"const": false},
    "supersedes_registered_profile_readiness": {"const": true},
    "superseded_registered_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "path",
          "sha256",
          "historical_execution_eligibility",
          "current_interpretation"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "pattern": "^PLAN-[A-Z0-9][A-Z0-9._-]{5,127}$"
          },
          "path": {"$ref": "#/$defs/repository_path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "historical_execution_eligibility": {"const": "eligible-after-authorization"},
          "historical_authorized": {"type": "boolean"},
          "current_interpretation": {"const": "historical-consumed-nonreplayable"}
        }
      }
    },
    "superseded_execution_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "plan_id",
          "path",
          "sha256",
          "historical_terminal_state",
          "historical_execution_eligibility",
          "current_interpretation"
        ],
        "properties": {
          "contract_id": {"type": "string", "minLength": 8, "maxLength": 128},
          "plan_id": {
            "type": "string",
            "pattern": "^PLAN-[A-Z0-9][A-Z0-9._-]{5,127}$"
          },
          "path": {"$ref": "#/$defs/repository_path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "historical_terminal_state": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "historical_execution_eligibility": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "historical_authorized": {"type": "boolean"},
          "current_interpretation": {"const": "historical-consumed-nonreplayable"}
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8, "maxLength": 160}
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "profile_path", "profile_sha256", "requirements"],
      "properties": {
        "plan_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^PLAN-[A-Z0-9][A-Z0-9._-]{5,127}$"}
          ]
        },
        "profile_path": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repository_path"}
          ]
        },
        "profile_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8, "maxLength": 160}
        }
      },
      "oneOf": [
        {
          "properties": {
            "plan_id": {"type": "null"},
            "profile_path": {"type": "null"},
            "profile_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "plan_id": {"type": "string"},
            "profile_path": {"type": "string"},
            "profile_sha256": {"type": "string"}
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
