{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-l2m-human-decision.schema.json",
  "$comment": "Private offline decision contract only. A valid file is necessary but never sufficient authorization.",
  "title": "T07 Gate L2M private manual-console decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "decision_nonce",
    "approve_image_change_to_recommended_lambda_stack_22_04",
    "selected_image_alias",
    "selected_image_version",
    "approve_unique_matched_ssh_key_for_launch_only",
    "selected_ssh_key_name",
    "approve_manual_global_firewall_replacement",
    "approve_manual_regional_ruleset_creation",
    "approve_manual_console_launch_exactly_once",
    "approve_jupyter_only_access",
    "approve_no_ssh_during_gate_l2m",
    "approve_manual_console_termination",
    "approve_manual_regional_ruleset_deletion",
    "approve_manual_global_firewall_restoration",
    "attest_no_other_workspace_resource_depends_on_current_global_rules",
    "attest_exclusive_lambda_instance_mutation_window",
    "attest_user_will_remain_present_for_entire_billable_window",
    "acknowledge_console_or_control_plane_outage_can_extend_billing",
    "source_ipv4_cidr",
    "max_provider_cost_usd",
    "max_provider_wall_seconds",
    "max_user_checkpoint_seconds",
    "persistent_filesystem",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "decision_id": {"type": "string", "pattern": "^T07-L2M-[A-Z0-9._-]{3,48}$"},
    "decision_nonce": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approve_image_change_to_recommended_lambda_stack_22_04": {"const": true},
    "selected_image_alias": {"const": "img-0032"},
    "selected_image_version": {"const": "22.4.5-2141"},
    "approve_unique_matched_ssh_key_for_launch_only": {"const": true},
    "selected_ssh_key_name": {"const": "fractal-lambda-codex"},
    "approve_manual_global_firewall_replacement": {"const": true},
    "approve_manual_regional_ruleset_creation": {"const": true},
    "approve_manual_console_launch_exactly_once": {"const": true},
    "approve_jupyter_only_access": {"const": true},
    "approve_no_ssh_during_gate_l2m": {"const": true},
    "approve_manual_console_termination": {"const": true},
    "approve_manual_regional_ruleset_deletion": {"const": true},
    "approve_manual_global_firewall_restoration": {"const": true},
    "attest_no_other_workspace_resource_depends_on_current_global_rules": {"const": true},
    "attest_exclusive_lambda_instance_mutation_window": {"const": true},
    "attest_user_will_remain_present_for_entire_billable_window": {"const": true},
    "acknowledge_console_or_control_plane_outage_can_extend_billing": {"const": true},
    "source_ipv4_cidr": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
    },
    "max_provider_cost_usd": {"const": 2.0},
    "max_provider_wall_seconds": {"const": 3600},
    "max_user_checkpoint_seconds": {"const": 300},
    "persistent_filesystem": {"type": "null"},
    "notes": {"type": "string", "maxLength": 2048}
  }
}
