{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:t07-bounded-openai-secret-source:0.1.0",
  "title": "T07 bounded-smoke OpenAI secret-source contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "source_file",
    "source_file_binding",
    "source_path_binding_sha256",
    "source_assignment",
    "parser",
    "upstream_runtime_name",
    "metadata_runtime_name",
    "runtime_mapping",
    "local_runtime_file",
    "remote_runtime_file",
    "container_runtime_file",
    "runtime_file_mode",
    "runtime_value_contract",
    "remote_parent_mode",
    "remote_current_user_owned",
    "remote_parent_prepare_argv",
    "remote_parent_verify_argvs",
    "remote_parent_mode_stdout",
    "remote_parent_realpath_stdout",
    "remote_file_prepare_argv",
    "remote_file_verify_argvs",
    "remote_file_mode_stdout",
    "fallbacks",
    "user_created_sira_api_key_file_required",
    "complete_env_upload_permitted",
    "openai_api_key_fallback",
    "provider_credential_fallback",
    "secret_value_hash_permitted",
    "single_run_lifetime",
    "cleanup_required"
  ],
  "properties": {
    "provider": {"const": "OpenAI"},
    "source_file": {"const": "${OPENAI_DOTENV_FILE}"},
    "source_file_binding": {"const": "private-authorization-substitution"},
    "source_path_binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_assignment": {"const": "OPENAI_API_KEY"},
    "parser": {"const": "giclab-strict-non-shell-dotenv-v1"},
    "upstream_runtime_name": {"const": "SIRA_API_KEY"},
    "metadata_runtime_name": {"const": "OPENAI_API_KEY"},
    "runtime_mapping": {
      "const": "provider-native-metadata-and-ephemeral-sira-child-alias"
    },
    "local_runtime_file": {
      "const": "artifacts/t07/bounded-upload/RUN-T07-BOUNDED-HOST-0003/t07-bounded-openai-provider-key"
    },
    "remote_runtime_file": {
      "const": "/home/ubuntu/.config/giclab/openai_provider_key"
    },
    "container_runtime_file": {"const": "/run/secrets/sira_api_key"},
    "runtime_file_mode": {"const": "0600"},
    "runtime_value_contract": {
      "const": "single-nonempty-ascii-token-[A-Za-z0-9._-]-no-line-terminator-v1"
    },
    "remote_parent_mode": {"const": "0700"},
    "remote_current_user_owned": {"const": true},
    "remote_parent_prepare_argv": {
      "const": [
        "/usr/bin/install",
        "-d",
        "-m",
        "0700",
        "/home/ubuntu/.config/giclab"
      ]
    },
    "remote_parent_verify_argvs": {
      "const": [
        ["/usr/bin/test", "-d", "/home/ubuntu/.config/giclab"],
        ["/usr/bin/test", "-O", "/home/ubuntu/.config/giclab"],
        ["/usr/bin/stat", "--format=%a", "/home/ubuntu/.config/giclab"],
        [
          "/usr/bin/realpath",
          "--canonicalize-existing",
          "/home/ubuntu/.config/giclab"
        ],
        [
          "/usr/bin/test",
          "!",
          "-e",
          "/home/ubuntu/.config/giclab/openai_provider_key"
        ],
        [
          "/usr/bin/test",
          "!",
          "-L",
          "/home/ubuntu/.config/giclab/openai_provider_key"
        ]
      ]
    },
    "remote_parent_mode_stdout": {"const": "700"},
    "remote_parent_realpath_stdout": {
      "const": "/home/ubuntu/.config/giclab"
    },
    "remote_file_prepare_argv": {
      "const": [
        "/usr/bin/chmod",
        "0600",
        "/home/ubuntu/.config/giclab/openai_provider_key"
      ]
    },
    "remote_file_verify_argvs": {
      "const": [
        ["/usr/bin/test", "-f", "/home/ubuntu/.config/giclab/openai_provider_key"],
        ["/usr/bin/test", "!", "-L", "/home/ubuntu/.config/giclab/openai_provider_key"],
        ["/usr/bin/test", "-O", "/home/ubuntu/.config/giclab/openai_provider_key"],
        ["/usr/bin/stat", "--format=%a", "/home/ubuntu/.config/giclab/openai_provider_key"]
      ]
    },
    "remote_file_mode_stdout": {"const": "600"},
    "fallbacks": {"const": []},
    "user_created_sira_api_key_file_required": {"const": false},
    "complete_env_upload_permitted": {"const": false},
    "openai_api_key_fallback": {"const": "not-applicable-selected-source"},
    "provider_credential_fallback": {"const": "none"},
    "secret_value_hash_permitted": {"const": false},
    "single_run_lifetime": {"const": true},
    "cleanup_required": {"const": true}
  }
}
