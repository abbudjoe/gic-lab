{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:experiment:0.1.0",
  "title": "GIC Lab experiment protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "title",
    "question",
    "hypothesis",
    "study_stage",
    "lifecycle_status",
    "evidence_status",
    "outcome_status",
    "owner",
    "created_at",
    "updated_at",
    "source_contracts",
    "systems",
    "fixed_variables",
    "metrics",
    "sampling",
    "budget",
    "acceptance_criteria",
    "stop_conditions",
    "execution",
    "paths",
    "deviations"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 8},
    "question": {"type": "string", "minLength": 8},
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "null_hypothesis", "falsification_criteria"],
      "properties": {
        "statement": {"type": "string", "minLength": 8},
        "null_hypothesis": {"type": "string", "minLength": 8},
        "falsification_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 8}
        }
      }
    },
    "study_stage": {"enum": ["exploratory", "confirmatory"]},
    "lifecycle_status": {"enum": ["planned", "running", "completed", "cancelled", "blocked"]},
    "evidence_status": {"enum": ["not-evaluated", "preliminary", "replicated", "confirmed", "inconclusive", "contradicted", "retracted"]},
    "outcome_status": {"enum": ["pending", "supported", "not-supported", "mixed", "invalidated"]},
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"},
    "source_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment", "controls"],
      "properties": {
        "treatment": {"type": "string", "minLength": 1},
        "controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "fixed_variables": {"type": "object"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "secondary": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_ids", "sample_size", "replications", "seeds"],
      "properties": {
        "dataset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "sample_size": {"type": "integer", "minimum": 0},
        "replications": {"type": "integer", "minimum": 0},
        "seeds": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_model_tokens", "max_tool_calls", "max_gpu_hours", "max_cost_usd"],
      "properties": {
        "max_model_tokens": {"type": ["integer", "null"], "minimum": 0},
        "max_tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "max_gpu_hours": {"type": "number", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "authorization_reference"],
      "properties": {
        "authorized": {"type": "boolean"},
        "authorization_reference": {"type": ["string", "null"]}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "config", "results"],
      "properties": {
        "protocol": {"type": "string", "minLength": 1},
        "config": {"type": "string", "minLength": 1},
        "results": {"type": "string", "minLength": 1}
      }
    },
    "deviations": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_status": {"const": "not-evaluated"}}, "required": ["evidence_status"]},
      "then": {"properties": {"outcome_status": {"const": "pending"}}}
    },
    {
      "if": {"properties": {"lifecycle_status": {"const": "planned"}}, "required": ["lifecycle_status"]},
      "then": {"properties": {"execution": {"properties": {"authorized": {"const": false}}}}}
    }
  ]
}
