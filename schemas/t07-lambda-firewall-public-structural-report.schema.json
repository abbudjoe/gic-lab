{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-firewall-public-structural-report.schema.json",
  "title": "Public value-free T07 firewall structural report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_version",
    "evidence_classification",
    "canonicalization_version",
    "response_parser_version",
    "baseline_alias",
    "canonical_semantic_sha256",
    "observation_top_level_fields",
    "observation_top_level_types",
    "global_ruleset_fields",
    "global_ruleset_types",
    "compatible_top_level_extensions",
    "compatible_extension_observed",
    "rule_count",
    "rule_shapes",
    "empty_description_count",
    "nonempty_description_count",
    "protocol_class_count",
    "all_current_required_fields_present",
    "all_port_range_presence_distinguished",
    "raw_response_retained",
    "unknown_raw_key_structure_retained",
    "sensitive_scalar_values_retained"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "report_version": {"const": "t07-firewall-public-structural-v1"},
    "evidence_classification": {"const": "complete_pre_mutation_provider_baseline"},
    "canonicalization_version": {"const": "t07-firewall-canonical-v1"},
    "response_parser_version": {"const": "t07-firewall-response-v2"},
    "baseline_alias": {"type": "string", "pattern": "^l2m-firewall-baseline-[a-f0-9]{12}$"},
    "canonical_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "observation_top_level_fields": {"$ref": "#/$defs/keyNames"},
    "observation_top_level_types": {"$ref": "#/$defs/keyTypes"},
    "global_ruleset_fields": {"$ref": "#/$defs/keyNames"},
    "global_ruleset_types": {"$ref": "#/$defs/keyTypes"},
    "compatible_top_level_extensions": {
      "type": "array",
      "maxItems": 61,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
          "type": {"enum": ["array", "boolean", "integer", "null", "number", "object", "string"]}
        }
      }
    },
    "compatible_extension_observed": {"type": "boolean"},
    "rule_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "rule_shapes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fields", "types"],
        "properties": {
          "fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["description", "port_range", "protocol", "source_network"]}
          },
          "types": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "port_range", "protocol", "source_network"],
            "properties": {
              "description": {"enum": ["string", "absent"]},
              "port_range": {"enum": ["array", "absent"]},
              "protocol": {"enum": ["string", "absent"]},
              "source_network": {"enum": ["string", "absent"]}
            }
          }
        }
      }
    },
    "empty_description_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "nonempty_description_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "protocol_class_count": {"type": "integer", "minimum": 0, "maximum": 4},
    "all_current_required_fields_present": {"const": true},
    "all_port_range_presence_distinguished": {"const": true},
    "raw_response_retained": {"const": true},
    "unknown_raw_key_structure_retained": {"const": true},
    "sensitive_scalar_values_retained": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "keyNames": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}
    },
    "keyTypes": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "enum": ["array", "boolean", "integer", "null", "number", "object", "string"]
      },
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}
    }
  }
}
