{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:pricing:0.1.0",
  "title": "GIC Lab model pricing record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "provider",
    "service_tier",
    "currency",
    "retrieved_at",
    "source",
    "model_manifest_id",
    "model_family",
    "proposed_revision",
    "rates_per_million_tokens",
    "cap_method",
    "profiles",
    "authorization",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "pattern": "^PRICE-[A-Z0-9][A-Z0-9._-]{5,127}$"},
    "provider": {"type": "string", "minLength": 1},
    "service_tier": {"type": "string", "minLength": 1},
    "currency": {"const": "USD"},
    "retrieved_at": {"type": "string", "format": "date"},
    "source": {"type": "string", "format": "uri"},
    "model_manifest_id": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "proposed_revision": {"type": "string", "minLength": 1},
    "rates_per_million_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "cached_input", "output"],
      "properties": {
        "input": {"type": "number", "minimum": 0},
        "cached_input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0}
      }
    },
    "cap_method": {"type": "string", "minLength": 8},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile-cap"}
    },
    "authorization": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "boolean"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    }
  },
  "$defs": {
    "profile-cap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_attempts",
        "max_model_tokens_per_attempt",
        "max_cost_usd_per_attempt",
        "calculation",
        "proposed_profile_cap_usd"
      ],
      "properties": {
        "condition_attempts": {"type": "integer", "minimum": 1},
        "max_model_tokens_per_attempt": {"type": "integer", "minimum": 0},
        "max_cost_usd_per_attempt": {"type": "number", "minimum": 0},
        "calculation": {"type": "string", "minLength": 8},
        "proposed_profile_cap_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
