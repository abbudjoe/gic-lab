{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gic-lab:schema:t09-full-dynamic-frozen-manifest:0.1.0",
  "title": "T09 retained full dynamic frozen-run manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "manifest_id",
    "plan_id",
    "host_run_id",
    "qualification_id",
    "qualification_count",
    "build_count",
    "image_materialization_policy",
    "source_contract_sha256",
    "clean_package_commit",
    "plan_sha256",
    "execution_contract_sha256",
    "runtime_contract_sha256",
    "command_manifests_sha256",
    "provider_entry_receipt_sha256",
    "owned_instance_identity_sha256",
    "provider_preflight_started_at_epoch",
    "owned_lambda_started_at_epoch",
    "first_pair_started_at_epoch",
    "launch_slot",
    "launch_count",
    "replacement_image_id",
    "python_interpreter_path",
    "python_interpreter_sha256",
    "runtime_preflight_sha256",
    "offline_preflight_sha256",
    "core_suppression_preflight_sha256",
    "sealing_primitives_preflight_sha256",
    "browser_preflight_sha256",
    "evaluator_materialization_sha256",
    "final_image_file_hashes_sha256",
    "model_metadata_receipt_sha256",
    "model_metadata_credential_scan_sha256",
    "model_metadata_request_count",
    "model_task_request_count",
    "task_browser_action_count",
    "actual_credential_exposure_detected",
    "credential_safety_stop_detected",
    "core_safety_stop_detected",
    "local_finalizer_qualification_sha256",
    "local_finalizer_interpreter_sha256",
    "local_finalizer_interpreter_dependency_manifest_sha256",
    "local_finalizer_interpreter_dependency_tree_sha256",
    "local_finalizer_evaluator_dependency_tree_sha256",
    "command_argv_sha256s",
    "pair_diffs",
    "attempt_order",
    "empirical_entry_crossed",
    "post_entry_code_science_image_freeze",
    "source_receipts"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "manifest_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "host_run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "qualification_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "qualification_count": {"const": 1},
    "build_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "image_materialization_policy": {"type": "string", "minLength": 1},
    "source_contract_sha256": {"$ref": "#/$defs/sha"},
    "clean_package_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "plan_sha256": {"$ref": "#/$defs/sha"},
    "execution_contract_sha256": {"$ref": "#/$defs/sha"},
    "runtime_contract_sha256": {"$ref": "#/$defs/sha"},
    "command_manifests_sha256": {"$ref": "#/$defs/sha"},
    "provider_entry_receipt_sha256": {"$ref": "#/$defs/sha"},
    "owned_instance_identity_sha256": {"$ref": "#/$defs/sha"},
    "provider_preflight_started_at_epoch": {"type": "number", "minimum": 0},
    "owned_lambda_started_at_epoch": {"type": "number", "minimum": 0},
    "first_pair_started_at_epoch": {"type": "number", "minimum": 0},
    "launch_slot": {"type": "integer", "minimum": 1},
    "launch_count": {"type": "integer", "minimum": 1},
    "replacement_image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "python_interpreter_path": {"type": "string", "pattern": "^/"},
    "python_interpreter_sha256": {"$ref": "#/$defs/sha"},
    "runtime_preflight_sha256": {"$ref": "#/$defs/sha"},
    "offline_preflight_sha256": {"$ref": "#/$defs/sha"},
    "core_suppression_preflight_sha256": {"$ref": "#/$defs/sha"},
    "sealing_primitives_preflight_sha256": {"$ref": "#/$defs/sha"},
    "browser_preflight_sha256": {"$ref": "#/$defs/sha"},
    "evaluator_materialization_sha256": {"$ref": "#/$defs/sha"},
    "final_image_file_hashes_sha256": {"$ref": "#/$defs/sha"},
    "model_metadata_receipt_sha256": {"$ref": "#/$defs/sha"},
    "model_metadata_credential_scan_sha256": {"$ref": "#/$defs/sha"},
    "model_metadata_request_count": {"const": 1},
    "model_task_request_count": {"const": 0},
    "task_browser_action_count": {"const": 0},
    "actual_credential_exposure_detected": {"const": false},
    "credential_safety_stop_detected": {"const": false},
    "core_safety_stop_detected": {"const": false},
    "local_finalizer_qualification_sha256": {"$ref": "#/$defs/sha"},
    "local_finalizer_interpreter_sha256": {"$ref": "#/$defs/sha"},
    "local_finalizer_interpreter_dependency_manifest_sha256": {"$ref": "#/$defs/sha"},
    "local_finalizer_interpreter_dependency_tree_sha256": {"$ref": "#/$defs/sha"},
    "local_finalizer_evaluator_dependency_tree_sha256": {"$ref": "#/$defs/sha"},
    "command_argv_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/sha"}
    },
    "pair_diffs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["valid"],
        "properties": {"valid": {"const": true}}
      }
    },
    "attempt_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "empirical_entry_crossed": {"const": false},
    "post_entry_code_science_image_freeze": {"const": true},
    "source_receipts": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"type": ["string", "null"]}
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
