{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-l2-plan.schema.json",
  "$comment": "Non-authoritative rejected design; Gate L2 is blocked and no executable plan exists.",
  "title": "T07 Gate L2 rejected non-executable Lambda host design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "authorization_reference",
    "authorization_state",
    "executable_after_exact_authorization",
    "authorized",
    "branch",
    "reviewed_implementation_commit",
    "provider",
    "source_contracts",
    "scientific_boundary",
    "public_selection",
    "private_binding",
    "runtime_bindings",
    "provider_operations",
    "firewall_transaction",
    "launch_contract",
    "host_key_checkpoint",
    "ssh_contract",
    "containment_probe",
    "network_allowlist",
    "evidence_and_cleanup",
    "limits",
    "actors",
    "terminal_state",
    "next_gate",
    "cloud_mutation_allowed_now",
    "paid_compute_allowed_now",
    "ssh_allowed_now",
    "container_allowed_now",
    "model_calls_allowed",
    "browser_automation_allowed",
    "sira_execution_allowed"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "plan_id": {"const": "PLAN-T07-GATE-L2-LAMBDA-HOST-QUALIFICATION-V1"},
    "run_id": {"const": "RUN-T07-L2-LAMBDA-HOST-QUALIFICATION-0001"},
    "authorization_reference": {"const": "AUTH-T07-GATE-L2-LAMBDA-HOST-QUALIFICATION-V1-PENDING"},
    "authorization_state": {"const": "blocked-source-and-control-plane"},
    "executable_after_exact_authorization": {"const": false},
    "authorized": {"const": false},
    "branch": {"const": "phase-1/sira-smoke-lambda"},
    "reviewed_implementation_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "provider": {"$ref": "#/$defs/object"},
    "source_contracts": {"$ref": "#/$defs/object"},
    "scientific_boundary": {"$ref": "#/$defs/object"},
    "public_selection": {"$ref": "#/$defs/object"},
    "private_binding": {"$ref": "#/$defs/object"},
    "runtime_bindings": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/object"}},
    "provider_operations": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "required": ["ordinal", "id", "method", "path", "max_calls", "expected_status"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 22},
          "id": {"type": "string", "minLength": 1},
          "method": {"enum": ["GET", "POST", "PATCH", "DELETE"]},
          "path": {"type": "string", "pattern": "^/api/v1/"},
          "max_calls": {"type": "integer", "minimum": 1, "maximum": 60},
          "expected_status": {"const": 200},
          "private_body": {"type": "string", "minLength": 1},
          "incident_only": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "firewall_transaction": {"$ref": "#/$defs/object"},
    "launch_contract": {"$ref": "#/$defs/object"},
    "host_key_checkpoint": {"$ref": "#/$defs/object"},
    "ssh_contract": {"$ref": "#/$defs/object"},
    "containment_probe": {"$ref": "#/$defs/object"},
    "network_allowlist": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/object"}},
    "evidence_and_cleanup": {"$ref": "#/$defs/object"},
    "limits": {
      "type": "object",
      "minProperties": 50,
      "additionalProperties": {"type": ["integer", "string"]}
    },
    "actors": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/object"}},
    "terminal_state": {"const": "blocked-human-or-source-decision"},
    "next_gate": {"const": "source-and-control-plane-repair-requires-new-reviewed-plan"},
    "cloud_mutation_allowed_now": {"const": false},
    "paid_compute_allowed_now": {"const": false},
    "ssh_allowed_now": {"const": false},
    "container_allowed_now": {"const": false},
    "model_calls_allowed": {"const": false},
    "browser_automation_allowed": {"const": false},
    "sira_execution_allowed": {"const": false}
  },
  "$defs": {
    "object": {"type": "object", "minProperties": 1}
  }
}
