{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t09-essential-failure-export-acknowledgement.schema.json",
  "title": "T09 bounded essential-failure export acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "export_identity", "essential_manifest_sha256",
    "essential_receipt_sha256", "essential_file_count", "essential_total_bytes",
    "destination_identity", "export_complete", "resumed", "envelope_padding"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "export_identity": {"$ref": "#/$defs/sha"},
    "essential_manifest_sha256": {"$ref": "#/$defs/sha"},
    "essential_receipt_sha256": {"$ref": "#/$defs/sha"},
    "essential_file_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "essential_total_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "destination_identity": {"$ref": "#/$defs/sha"},
    "export_complete": {"const": true},
    "resumed": {"type": "boolean"},
    "envelope_padding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": {"const": "envelope-padding.bin"},
            "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
            "sha256": {"$ref": "#/$defs/sha"}
          }
        }
      ]
    }
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
