{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-l2-transaction-journal.schema.json",
  "$comment": "Append-only private operational evidence; this schema grants no execution authority.",
  "title": "T07 Lambda Gate L2 transaction-journal event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "authorization_reference",
    "actor",
    "event_sequence",
    "event_type",
    "operation_ordinal",
    "request_ordinal",
    "resource_alias",
    "private_parameter_seal_reference",
    "monotonic_timestamp_ns",
    "wall_timestamp_utc",
    "elapsed_ms",
    "response_bytes",
    "provider_calls_used",
    "process_calls_used",
    "output_bytes_used",
    "terminal_status",
    "sanitized_failure_class"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"const": "RUN-T07-L2-LAMBDA-HOST-QUALIFICATION-0002"},
    "plan_id": {"const": "PLAN-T07-GATE-L2-LAMBDA-HOST-QUALIFICATION-V2"},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "actor": {"enum": ["primary", "watchdog"]},
    "event_sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
    "event_type": {
      "enum": [
        "supervisor_started",
        "preflight_inventory_verified",
        "watchdog_ready",
        "firewall_snapshot_sealed",
        "global_firewall_strict_verified",
        "regional_ruleset_strict_verified",
        "launch_body_sealed",
        "launch_intent_committed",
        "launch_send_started",
        "launch_response_received",
        "launch_response_validated",
        "launch_response_unknown_after_send",
        "launch_definitively_rejected",
        "discovery_started",
        "owned_instance_not_yet_visible",
        "owned_instance_discovered",
        "owned_instance_ambiguous",
        "owned_instance_bound",
        "provider_request_intent",
        "provider_request_send_started",
        "provider_response_received",
        "provider_request_failed",
        "process_intent",
        "process_completed",
        "checkpoint_passed",
        "host_inspection_passed",
        "containment_passed",
        "evidence_transfer_passed",
        "cleanup_required",
        "termination_intent_committed",
        "termination_send_started",
        "termination_response_unknown",
        "instance_terminal_proven",
        "regional_ruleset_deleted",
        "global_firewall_restored",
        "archive_finalized",
        "all_clean_sealed",
        "high_severity_incident",
        "supervisor_stopped"
      ]
    },
    "operation_ordinal": {"type": "integer", "minimum": 0, "maximum": 4096},
    "request_ordinal": {"type": ["integer", "null"], "minimum": 1, "maximum": 420},
    "resource_alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "private_parameter_seal_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "monotonic_timestamp_ns": {"type": "integer", "minimum": 0},
    "wall_timestamp_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 5400000},
    "response_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "provider_calls_used": {"type": "integer", "minimum": 0, "maximum": 420},
    "process_calls_used": {"type": "integer", "minimum": 0, "maximum": 128},
    "output_bytes_used": {"type": "integer", "minimum": 0, "maximum": 100663296},
    "terminal_status": {"type": "string", "minLength": 1, "maxLength": 96},
    "sanitized_failure_class": {"type": ["string", "null"], "pattern": "^[a-z0-9_]{1,96}$"}
  }
}
