{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/t07-lambda-l2m-host-evidence.schema.json",
  "$comment": "Private host-qualification evidence. Public summaries may retain only aliases, counts, versions, booleans, sizes, and hashes.",
  "title": "T07 Gate L2M Jupyter host qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "authorization_reference",
    "authorization_sha256",
    "decision_alias",
    "marker_alias",
    "instance_binding_sha256",
    "bundle_manifest_sha256",
    "host",
    "runtime",
    "busybox",
    "containment",
    "prohibitions"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "pattern": "^RUN-T07-L2M-[A-Z0-9._-]{3,64}$"},
    "authorization_reference": {
      "type": "string",
      "pattern": "^AUTH-T07-(?:GATE-)?L2M-[A-Z0-9._-]{3,96}$"
    },
    "authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_alias": {"type": "string", "pattern": "^l2m-decision-[a-f0-9]{12}$"},
    "marker_alias": {"type": "string", "pattern": "^l2m-marker-[a-f0-9]{12}$"},
    "instance_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_id",
        "os_version_id",
        "kernel_release",
        "architecture",
        "python_version",
        "cgroup_mode",
        "root_total_bytes",
        "root_free_bytes"
      ],
      "properties": {
        "os_id": {"const": "ubuntu"},
        "os_version_id": {"type": "string", "pattern": "^22\\.04(?:\\..*)?$"},
        "kernel_release": {"type": "string", "minLength": 1, "maxLength": 256},
        "architecture": {"const": "x86_64"},
        "python_version": {"type": "string", "pattern": "^3\\.10(?:\\..*)?$"},
        "cgroup_mode": {"enum": ["v1", "v2", "hybrid"]},
        "root_total_bytes": {"type": "integer", "minimum": 107374182400},
        "root_free_bytes": {"type": "integer", "minimum": 10737418240}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker_client_version",
        "docker_server_version",
        "containerd_version",
        "runc_version",
        "buildx_version",
        "buildkit_version",
        "docker_service_active",
        "docker_endpoint_kind",
        "initial_container_count",
        "initial_image_count",
        "initial_state_sha256"
      ],
      "properties": {
        "docker_client_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "docker_server_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "containerd_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "runc_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "buildx_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "buildkit_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "docker_service_active": {"const": true},
        "docker_endpoint_kind": {"const": "local-unix-socket"},
        "initial_container_count": {"type": "integer", "const": 0},
        "initial_image_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "initial_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "busybox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_reference",
        "manifest_digest",
        "config_digest",
        "layer_digest",
        "layer_bytes",
        "platform",
        "config_metadata_platform_proven",
        "public_metadata_observation_sha256",
        "public_registry_metadata_reverified_at_utc",
        "public_registry_metadata_reverified_before_qualification",
        "public_metadata_binding_validated_during_qualification",
        "public_metadata_age_seconds",
        "public_registry_metadata_request_during_qualification",
        "pull_count",
        "image_record_sha256"
      ],
      "properties": {
        "image_reference": {"const": "busybox@sha256:7a3ebe5bfd1a4a19797d20b0c0bb39d44393e9a03fd852c0865b0f540d868df0"},
        "manifest_digest": {"const": "sha256:7a3ebe5bfd1a4a19797d20b0c0bb39d44393e9a03fd852c0865b0f540d868df0"},
        "config_digest": {"const": "sha256:db287cb6be81219cd18c1d82b70908f5d33eb028568b456f78eedff2ff2930e4"},
        "layer_digest": {"const": "sha256:436a1b1fd078ee8e117111472724c2827077657189af7a781829d0825d48d2ab"},
        "layer_bytes": {"const": 2211507},
        "platform": {"const": "linux/amd64"},
        "config_metadata_platform_proven": {"const": true},
        "public_metadata_observation_sha256": {
          "const": "56a1ba759d4fc5ac6eba2ee85c5bff2a08d0d71f538793f3de5732bb80d0b1a5"
        },
        "public_registry_metadata_reverified_at_utc": {
          "const": "2026-08-11T06:15:19.646016Z"
        },
        "public_registry_metadata_reverified_before_qualification": {"const": true},
        "public_metadata_binding_validated_during_qualification": {"const": true},
        "public_metadata_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "public_registry_metadata_request_during_qualification": {"const": false},
        "pull_count": {"const": 1},
        "image_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_id_sha256",
        "create_argv_sha256",
        "fixture_sha256",
        "fixture_identity_sha256",
        "network_none",
        "private_pid_namespace",
        "private_cgroup_namespace",
        "private_ipc_namespace",
        "privileged",
        "cap_drop_all",
        "no_new_privileges",
        "read_only_root",
        "restart_policy",
        "cpu_limit_millis",
        "memory_bytes",
        "memory_swap_bytes",
        "pid_limit",
        "tmpfs_bytes_each",
        "shm_bytes",
        "workload_wall_seconds",
        "term_sent",
        "kill_escalated",
        "terminal_proven",
        "removed",
        "owned_container_residue_count",
        "owned_network_residue_count",
        "owned_volume_residue_count",
        "background_process_residue_count",
        "owned_cgroup_residue_count",
        "residue_scan_sha256",
        "residue_scanned_process_count",
        "residue_scanned_cgroup_entries",
        "pre_stop_process_count",
        "pre_stop_max_parent_depth",
        "pre_stop_distinct_sid_count",
        "pre_stop_reparented_session_leader_count",
        "post_term_process_count",
        "post_term_max_parent_depth",
        "post_term_distinct_sid_count",
        "pid_limit_observed",
        "term_ignoring_descendants_proven",
        "process_structure_sha256"
      ],
      "properties": {
        "container_id_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "create_argv_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fixture_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "network_none": {"const": true},
        "private_pid_namespace": {"const": true},
        "private_cgroup_namespace": {"const": true},
        "private_ipc_namespace": {"const": true},
        "privileged": {"const": false},
        "cap_drop_all": {"const": true},
        "no_new_privileges": {"const": true},
        "read_only_root": {"const": true},
        "restart_policy": {"const": "no"},
        "cpu_limit_millis": {"const": 1000},
        "memory_bytes": {"const": 536870912},
        "memory_swap_bytes": {"const": 536870912},
        "pid_limit": {"const": 64},
        "tmpfs_bytes_each": {"const": 16777216},
        "shm_bytes": {"const": 16777216},
        "workload_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "term_sent": {"const": true},
        "kill_escalated": {"const": true},
        "terminal_proven": {"const": true},
        "removed": {"const": true},
        "owned_container_residue_count": {"const": 0},
        "owned_network_residue_count": {"const": 0},
        "owned_volume_residue_count": {"const": 0},
        "background_process_residue_count": {"const": 0},
        "owned_cgroup_residue_count": {"const": 0},
        "residue_scan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "residue_scanned_process_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "residue_scanned_cgroup_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "pre_stop_process_count": {"type": "integer", "minimum": 60, "maximum": 64},
        "pre_stop_max_parent_depth": {"type": "integer", "minimum": 2, "maximum": 64},
        "pre_stop_distinct_sid_count": {"type": "integer", "minimum": 2, "maximum": 64},
        "pre_stop_reparented_session_leader_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "post_term_process_count": {"type": "integer", "minimum": 3, "maximum": 64},
        "post_term_max_parent_depth": {"type": "integer", "minimum": 2, "maximum": 64},
        "post_term_distinct_sid_count": {"type": "integer", "minimum": 2, "maximum": 64},
        "pid_limit_observed": {"const": true},
        "term_ignoring_descendants_proven": {"const": true},
        "process_structure_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "prohibitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ssh_operations",
        "model_calls",
        "browser_actions",
        "sira_executions",
        "scientific_executions",
        "apt_operations",
        "runtime_updates",
        "secrets_accessed"
      ],
      "properties": {
        "ssh_operations": {"const": 0},
        "model_calls": {"const": 0},
        "browser_actions": {"const": 0},
        "sira_executions": {"const": 0},
        "scientific_executions": {"const": 0},
        "apt_operations": {"const": 0},
        "runtime_updates": {"const": 0},
        "secrets_accessed": {"const": 0}
      }
    }
  }
}
