{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gic-lab.invalid/schemas/agent-incident.schema.json",
  "title": "GIC Lab control-plane incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "observed_package",
    "stage",
    "failed_invariant",
    "root_cause",
    "live_environment_required",
    "earliest_detectable_stage",
    "authority_consumed",
    "cost_usd",
    "affected_abstraction",
    "repair",
    "coverage",
    "regressions",
    "status",
    "scientific_result",
    "scientific_interpretation_allowed",
    "immutable_facts",
    "immutable_facts_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "incident_id": {
      "enum": [
        "INC-T09-V16-LIFECYCLE-REGISTRY",
        "INC-T09-CONTROL-FIXED-TARGET-SELECTION",
        "INC-T09-CONTROL-SHADOW-SHAPED-LIVE-BOUNDARY",
        "INC-T09-CONTROL-LIVE-BOUNDARY-EXACT-HEAD-REVIEW"
      ]
    },
    "observed_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "plan_id", "merged_package"],
      "properties": {
        "version": {"type": "string", "pattern": "^V[1-9][0-9]*$"},
        "plan_id": {"type": "string", "pattern": "^PLAN-EXP0001-PILOT-V[1-9][0-9]*$"},
        "merged_package": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "stage": {"type": "string", "minLength": 1},
    "failed_invariant": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "live_environment_required": {"const": false},
    "earliest_detectable_stage": {"type": "string", "minLength": 1},
    "authority_consumed": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["metadata", "provider_launch"],
          "properties": {
            "metadata": {"type": "boolean"},
            "provider_launch": {"type": "boolean"}
          }
        },
        {"const": "none"}
      ]
    },
    "cost_usd": {"const": "0.00"},
    "affected_abstraction": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "repair": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "array",
      "contains": {"enum": ["offline-composition", "shadow-execution", "target-resolution"]},
      "items": {"enum": ["offline-composition", "shadow-execution", "target-resolution"]},
      "uniqueItems": true
    },
    "regressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"enum": ["test-node", "receipt"]},
          "reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {"enum": ["open", "resolved"]},
    "scientific_result": {"const": "not-run"},
    "scientific_interpretation_allowed": {"const": false},
    "immutable_facts": {"type": "object", "minProperties": 1},
    "immutable_facts_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"incident_id": {"const": "INC-T09-V16-LIFECYCLE-REGISTRY"}}},
      "then": {
        "properties": {
          "observed_package": {
            "properties": {
              "version": {"const": "V16"},
              "plan_id": {"const": "PLAN-EXP0001-PILOT-V16"},
              "merged_package": {"const": "450a10a51eda4c428f20b27d6b4aafc4f94d80f4"}
            }
          },
          "stage": {"const": "provider-preflight-before-secret-loading"},
          "earliest_detectable_stage": {"const": "offline-composition"},
          "authority_consumed": {
            "const": {"metadata": true, "provider_launch": false}
          },
          "affected_abstraction": {
            "contains": {"const": "registry/lifecycle-dispatch"}
          },
          "repair": {"const": "semantic-capability-dispatch"},
          "coverage": {
            "contains": {"enum": ["offline-composition", "shadow-execution"]},
            "items": {"enum": ["offline-composition", "shadow-execution"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"incident_id": {"const": "INC-T09-CONTROL-FIXED-TARGET-SELECTION"}}},
      "then": {
        "properties": {
          "observed_package": {
            "properties": {
              "version": {"const": "V16"},
              "plan_id": {"const": "PLAN-EXP0001-PILOT-V16"},
              "merged_package": {"const": "d0aff8a47e92013773d9d05b2cd90fb741658b03"}
            }
          },
          "stage": {"const": "post-stabilization-package-boundary-review"},
          "failed_invariant": {
            "const": "a successor package must not require shared aggregate-control source edits"
          },
          "root_cause": {
            "const": "agent-check, CLI, and Make targets selected V16 explicitly"
          },
          "earliest_detectable_stage": {"const": "package-only-boundary-audit"},
          "authority_consumed": {"const": "none"},
          "affected_abstraction": {
            "const": ["aggregate-control/target-selection"]
          },
          "repair": {"const": "goal-compatible-selected-runtime-target-resolver"},
          "coverage": {"const": ["target-resolution", "shadow-execution"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "incident_id": {
            "const": "INC-T09-CONTROL-SHADOW-SHAPED-LIVE-BOUNDARY"
          }
        }
      },
      "then": {
        "properties": {
          "observed_package": {
            "properties": {
              "version": {"const": "V16"},
              "plan_id": {"const": "PLAN-EXP0001-PILOT-V16"},
              "merged_package": {
                "const": "f1d872d59c4952eb98467c2506850af7772f4454"
              }
            }
          },
          "stage": {"const": "post-merge package-only boundary audit"},
          "failed_invariant": {
            "const": "package-specific live effects must execute the same controller and production assembly without shared-source changes or shadow substitutions"
          },
          "root_cause": {
            "const": "fake credential transport; synthetic clock and sleep; synthetic staging and freeze; one hardcoded model call; synthetic raw, finalizer, and evaluator outputs; fake-scenario production coupling; under-bound effect authority"
          },
          "earliest_detectable_stage": {
            "const": "shared-production-effect-boundary-audit"
          },
          "authority_consumed": {"const": "none"},
          "affected_abstraction": {
            "const": [
              "shared-control/production-effect-boundary",
              "shared-control/effect-authority",
              "shared-control/evidence-chain"
            ]
          },
          "repair": {"const": "effect-neutral-live-capable-production-seams"},
          "coverage": {
            "const": [
              "offline-composition",
              "shadow-execution",
              "target-resolution"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "incident_id": {
            "const": "INC-T09-CONTROL-LIVE-BOUNDARY-EXACT-HEAD-REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "observed_package": {
            "properties": {
              "version": {"const": "V16"},
              "plan_id": {"const": "PLAN-EXP0001-PILOT-V16"},
              "merged_package": {
                "const": "3291af1e64ec1ea89b8773a586c97a917f1052a2"
              }
            }
          },
          "stage": {"const": "exact-head live-boundary review"},
          "failed_invariant": {
            "const": "Task A checkpoint policy, post-entry failure evidence, live authority, and effect/root/evidence identities must remain authoritative and held across the shared transaction"
          },
          "root_cause": {
            "const": "checkpoint bypassed retained policy; post-entry failures lacked essential evidence; effect and provider authority could split; module, root, and evidence identities were pathname-reopened"
          },
          "earliest_detectable_stage": {
            "const": "exact-head live-boundary review"
          },
          "authority_consumed": {"const": "none"},
          "affected_abstraction": {
            "const": [
              "shared-control/first-pair-checkpoint",
              "shared-control/essential-failure-evidence",
              "shared-control/live-authorization-transaction",
              "shared-control/held-identity-boundary"
            ]
          },
          "repair": {
            "const": "authoritative-checkpoint-failure-authority-and-held-identity-repair"
          },
          "coverage": {
            "const": [
              "offline-composition",
              "shadow-execution",
              "target-resolution"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
